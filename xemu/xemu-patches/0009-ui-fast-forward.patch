+++ b/xemu/ui/xemu.c
@@ -81,6 +81,35 @@
 uint64_t vblank_interval_ns = 16666666LL;
 bool use_vblank_timer_thread = true;
 
+/*
+ * XGrid: fast-forward runs the vblank pace faster without changing the guest's
+ * clock. The shell sets it from its own thread; the vblank thread reads it once
+ * per frame, so the value is atomic.
+ */
+static int xemu_speed_multiplier = 1;
+static const int XEMU_MAX_SPEED_MULTIPLIER = 8;
+
+void xemu_set_speed_multiplier(int multiplier)
+{
+    if (multiplier < 1) {
+        multiplier = 1;
+    } else if (multiplier > XEMU_MAX_SPEED_MULTIPLIER) {
+        multiplier = XEMU_MAX_SPEED_MULTIPLIER;
+    }
+
+    qatomic_set(&xemu_speed_multiplier, multiplier);
+}
+
+int xemu_get_speed_multiplier(void)
+{
+    return qatomic_read(&xemu_speed_multiplier);
+}
+
+static int64_t vblank_interval_current_ns(void)
+{
+    return vblank_interval_ns / qatomic_read(&xemu_speed_multiplier);
+}
+
