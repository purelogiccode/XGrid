diff --git a/include/system/os-win32.h b/include/system/os-win32.h
index 22d72bab..fbfe2997 100644
--- a/include/system/os-win32.h
+++ b/include/system/os-win32.h
@@ -86,7 +86,13 @@ void __attribute__((noreturn)) __mingw_longjmp(jmp_buf, int);
  * in terms of setjmp/longjmp on Win32.
  */
 #define sigjmp_buf jmp_buf
-#define sigsetjmp(env, savemask) setjmp(env)
+/*
+ * XGrid: save the jump buffer with a NULL unwind frame. longjmp then restores
+ * the context without an SEH unwind, which a managed host's vectored exception
+ * handlers would otherwise intercept. QEMU never needs the unwind: the CPU
+ * loop only jumps back to its own cpu_exec frame.
+ */
+#define sigsetjmp(env, savemask) _setjmp(env, NULL)
 #define siglongjmp(env, val) longjmp(env, val)
 
 /* Missing POSIX functions. Don't use MinGW-w64 macros. */
diff --git a/meson.build b/meson.build
index d94efe80..91d14456 100644
--- a/meson.build
+++ b/meson.build
@@ -4666,6 +4666,27 @@ foreach target : target_dirs
                link_args: link_args,
                win_subsystem: exe['win_subsystem'])
 
+    # XGrid: the shell loads the core in-process. A shared library gets a
+    # proper CRT initialisation from the loader, which an EXE loaded with
+    # LoadLibrary does not. It links the same objects as the emulator.
+    if host_os == 'windows' and target == 'i386-softmmu' and exe['win_subsystem'] == 'windows'
+      # Keep SEH unwind data: a hosted DLL's longjmp unwinds through the
+      # host's exception machinery, unlike the standalone binary.
+      xgrid_core_link_args = []
+      foreach arg : link_args
+        if arg != '-Wl,--no-seh'
+          xgrid_core_link_args += arg
+        endif
+      endforeach
+      xgrid_core = shared_library('xgrid_core',
+                    objects: lib.extract_all_objects(recursive: true),
+                    dependencies: arch_deps + exe['dependencies'],
+                    link_depends: [block_syms, qemu_syms],
+                    link_args: xgrid_core_link_args + ['-Wl,--image-base,0x150000000', '-Wl,--stack,16777216'],
+                    c_args: c_args,
+                    name_prefix: '')
+    endif
+
     if host_os == 'darwin'
       icon = 'pc-bios/qemu.rsrc'
       build_input = [emulator, files(icon)]
diff --git a/ui/xemu-run.h b/ui/xemu-run.h
new file mode 100644
index 00000000..8df96346
--- /dev/null
+++ b/ui/xemu-run.h
@@ -0,0 +1,34 @@
+/*
+ * XGrid in-process core entry points.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The standalone binary and the shell-hosted core share one run loop. QEMU's
+ * global state is single-use, so xemu_run() may be called at most once per
+ * process; xgrid_core_start() (xgrid-core/abi) is the supported wrapper.
+ */
+
+#ifndef XEMU_RUN_H
+#define XEMU_RUN_H
+
+#include <stdbool.h>
+
+/**
+ * Runs one machine to completion.
+ *
+ * @param argc Argument count, including the program name.
+ * @param argv Arguments; "-config_path <file>" selects the settings file.
+ * @param library_mode True when the caller owns the process: modal error
+ *                     dialogs are suppressed and startup failures are
+ *                     returned instead of terminating the process.
+ * @return The QEMU exit status.
+ */
+int xemu_run(int argc, char **argv, bool library_mode);
+
+/**
+ * Asks the run loop to power the machine off at its next iteration. Safe to
+ * call from any thread, including before xemu_run() has started.
+ */
+void xemu_request_shutdown(void);
+
+#endif /* XEMU_RUN_H */
