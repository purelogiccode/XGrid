+/* A Chihiro binding in the 1000 range is 1000 plus SDL's button number:
+ * 1001 = left, 1003 = right. SDL's button mask uses bit (button - 1). */
+static bool chihiro_mouse_button(int binding, uint32_t buttons)
+{
