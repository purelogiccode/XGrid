+    # Player 2's Card In (Ghost Squad's second slot)
+    card_in:
+      type: integer
+      default: 25
+    # Player 2's aim, for a gun cabinet: the crosshair moves while an aim key
+    # or the second gamepad's right stick is held. aim_speed is percent
+    # (100 crosses the picture in about 0.75 seconds).
+    aim_left:
+      type: integer
