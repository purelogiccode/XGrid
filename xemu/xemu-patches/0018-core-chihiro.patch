+        type: integer
+        default: 224
+    # Maximum Tune reads its H shifter and its two wheel buttons from the
+    # SECOND switch byte of player 1 (V322.xbe 0x00055AA0): bits 7/6 are the
+    # lever's up/down, bits 5/4 its left/right, and bits 1/0 the two buttons.
