 perf:
   hard_fpu:
     type: bool
diff --git a/xemu/hw/ide/core.c b/xemu/hw/ide/core.c
index 26fb5a6e..8410e0ff 100644
--- a/xemu/hw/ide/core.c
+++ b/xemu/hw/ide/core.c
@@ -43,6 +43,7 @@
 #include "system/runstate.h"
 #include "ide-internal.h"
 #include "trace.h"
+#include "hw/xbox/chihiro/chihiro.h"
 
 /* These values were based on a Seagate ST3500418AS but have been modified
    to make more sense in QEMU */
@@ -958,6 +959,20 @@ static void ide_dma_cb(void *opaque, int ret)
 
     trace_ide_dma_cb(s, sector_num, n, IDE_DMA_CMD_str(s->dma_cmd));
 
+    if (s->unit == 1 && n > 0) {
+        bool irq = false;
+        if (chihiro_ide_serve(s->dma_cmd, (uint32_t)sector_num, n,
+                              &s->sg, &irq)) {
+            ide_dma_buf_commit(s, s->sg.size);
+            sector_num += n;
+            ide_set_sector(s, sector_num);
+            s->nsector -= n;
+            s->status = READY_STAT | SEEK_STAT;
+            if (irq) ide_bus_set_irq(s->bus);
+            goto eot;
+        }
+    }
+
     if ((s->dma_cmd == IDE_DMA_READ || s->dma_cmd == IDE_DMA_WRITE) &&
         !ide_sect_range_ok(s, sector_num, n)) {
         ide_dma_error(s);
@@ -1459,6 +1474,33 @@ static bool cmd_identify(IDEState *s, uint8_t cmd)
         } else {
             ide_cfata_identify(s);
         }
+
+        /* Chihiro: override IDENTIFY for baseboard (unit 1).
+         * MAME's ide_baseboard_device reports CHS 65535/255/255.
+         * The arcdkrnl MediaBoard driver checks this geometry to
+         * distinguish the baseboard from a regular HDD. Without it,
+         * the kernel never creates \Device\MediaBoard partitions. */
+        if (s->unit == 1) {
+            uint16_t *p = (uint16_t *)s->identify_data;
+            put_le16(p + 1, 65535);  /* cylinders */
+            put_le16(p + 3, 255);    /* heads */
+            put_le16(p + 6, 255);    /* sectors per track */
+            put_le16(p + 54, 65535); /* current cylinders */
+            put_le16(p + 55, 255);   /* current heads */
+            put_le16(p + 56, 255);   /* current sectors */
+            padstr((char *)(p + 27), "SEGA CHIHIRO BASEBOARD", 40);
+            /* The DIMM's capacity, so the kernel maps every MediaBoard
+             * partition (mbcom is the last 0x8000 sectors); the Chihiro IDE
+             * hooks serve the reads and writes themselves. */
+            int64_t bb_sectors = (int64_t)0x40000 << chihiro_dimm_factor();
+            put_le16(p + 60, bb_sectors);
+            put_le16(p + 61, bb_sectors >> 16);
+            put_le16(p + 100, bb_sectors);
+            put_le16(p + 101, bb_sectors >> 16);
+            put_le16(p + 102, 0);
+            put_le16(p + 103, 0);
+        }
+
         s->status = READY_STAT | SEEK_STAT;
         ide_transfer_start(s, s->io_buffer, 512, ide_transfer_stop);
         ide_bus_set_irq(s->bus);
diff --git a/xemu/hw/usb/hcd-ohci.c b/xemu/hw/usb/hcd-ohci.c
index 7b3f120b..e9c49729 100644
--- a/xemu/hw/usb/hcd-ohci.c
+++ b/xemu/hw/usb/hcd-ohci.c
@@ -37,6 +37,7 @@
 #include "hw/qdev-properties.h"
 #include "trace.h"
 #include "hcd-ohci.h"
+#include "hw/xbox/chihiro/chihiro.h"
 
 /* This causes frames to occur 1000x slower */
 /*#define OHCI_TIME_WARP 1*/
@@ -280,18 +281,22 @@ static inline void ohci_set_interrupt(OHCIState *ohci, uint32_t intr)
 static USBDevice *ohci_find_device(OHCIState *ohci, uint8_t addr)
 {
     USBDevice *dev;
+    USBDevice *fallback = NULL;
     int i;
 
     for (i = 0; i < ohci->num_ports; i++) {
-        if ((ohci->rhport[i].ctrl & OHCI_PORT_PES) == 0) {
-            continue;
-        }
         dev = usb_find_device(&ohci->rhport[i].port, addr);
         if (dev != NULL) {
-            return dev;
+            int pes = (ohci->rhport[i].ctrl & OHCI_PORT_PES) ? 1 : 0;
+            if (pes) {
+                return dev;
+            }
+            if (!fallback) {
+                fallback = dev;
+            }
         }
     }
-    return NULL;
+    return fallback;
 }
 
 void ohci_stop_endpoints(OHCIState *ohci)
@@ -1284,6 +1289,11 @@ static void ohci_frame_boundary(void *opaque)
 static int ohci_bus_start(OHCIState *ohci)
 {
     trace_usb_ohci_start(ohci->name);
+
+    /* Chihiro: the USB devices attach after the kernel enables RHSC, so
+     * fresh CSC events trigger the full enumeration, SET_CONFIG included. */
+    chihiro_on_ohci_bus_start();
+
     /*
      * Delay the first SOF event by one frame time as linux driver is
      * not ready to receive it and can meet some race conditions
@@ -1298,6 +1308,9 @@ static int ohci_bus_start(OHCIState *ohci)
 void ohci_bus_stop(OHCIState *ohci)
 {
     trace_usb_ohci_stop(ohci->name);
+
+    chihiro_on_ohci_bus_stop();
+
     timer_del(ohci->eof_timer);
 }
 
@@ -1481,7 +1494,12 @@ static void ohci_port_set_status(OHCIState *ohci, int portnum, uint32_t val)
         port->ctrl &= ~(val & OHCI_PORT_WTC);
     }
     if (val & OHCI_PORT_CCS) {
+        /* ClearPortEnable goes through on a Chihiro too: the kernel's USB
+         * enumeration disables and re-enables the port
+         * (GET_DESC -> SET_ADDRESS -> ClearPortEnable -> re-enable ->
+         * SET_CONFIG). */
         port->ctrl &= ~OHCI_PORT_PES;
+        port->ctrl |= OHCI_PORT_PESC;
     }
     ohci_port_set_if_connected(ohci, portnum, val & OHCI_PORT_PES);
 
