<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- ===================== XGrid dark palette ===================== -->
      <Color x:Key="XgBackgroundColor">#070B10</Color>
      <Color x:Key="XgSidebarColor">#0A1018</Color>
      <Color x:Key="XgSurfaceColor">#0E1620</Color>
      <Color x:Key="XgSurfaceAltColor">#121C28</Color>
      <Color x:Key="XgSurfaceHoverColor">#172333</Color>
      <Color x:Key="XgBorderColor">#1E2C3E</Color>
      <Color x:Key="XgBorderStrongColor">#2A3C53</Color>
      <Color x:Key="XgTextColor">#EAF2FB</Color>
      <Color x:Key="XgTextSecondaryColor">#9FB2C9</Color>
      <Color x:Key="XgTextMutedColor">#6B8099</Color>
      <Color x:Key="XgErrorColor">#FF6B7D</Color>
      <Color x:Key="XgWarningColor">#F2B84B</Color>

      <SolidColorBrush x:Key="XgBackgroundBrush" Color="{StaticResource XgBackgroundColor}" />
      <SolidColorBrush x:Key="XgSidebarBrush" Color="{StaticResource XgSidebarColor}" />
      <SolidColorBrush x:Key="XgSurfaceBrush" Color="{StaticResource XgSurfaceColor}" />
      <SolidColorBrush x:Key="XgSurfaceAltBrush" Color="{StaticResource XgSurfaceAltColor}" />
      <SolidColorBrush x:Key="XgSurfaceHoverBrush" Color="{StaticResource XgSurfaceHoverColor}" />
      <SolidColorBrush x:Key="XgBorderBrush" Color="{StaticResource XgBorderColor}" />
      <SolidColorBrush x:Key="XgBorderStrongBrush" Color="{StaticResource XgBorderStrongColor}" />
      <SolidColorBrush x:Key="XgTextBrush" Color="{StaticResource XgTextColor}" />
      <SolidColorBrush x:Key="XgTextSecondaryBrush" Color="{StaticResource XgTextSecondaryColor}" />
      <SolidColorBrush x:Key="XgTextMutedBrush" Color="{StaticResource XgTextMutedColor}" />
      <SolidColorBrush x:Key="XgErrorBrush" Color="{StaticResource XgErrorColor}" />
      <SolidColorBrush x:Key="XgWarningBrush" Color="{StaticResource XgWarningColor}" />
      <SolidColorBrush x:Key="XgInsetBrush" Color="#0A1119" />
      <SolidColorBrush x:Key="XgOverlayBrush" Color="#E60B1119" />
      <SolidColorBrush x:Key="XgErrorSoftBrush" Color="#26FF6B7D" />
      <SolidColorBrush x:Key="XgWarningSoftBrush" Color="#26F2B84B" />
      <SolidColorBrush x:Key="XgAccentTextBrush" Color="#06200F" />

      <!-- Defaults; the AccentService swaps these application-wide at runtime. -->
      <Color x:Key="XgAccentColor">#57E389</Color>
      <SolidColorBrush x:Key="XgAccentBrush" Color="#57E389" />
      <SolidColorBrush x:Key="XgAccentHoverBrush" Color="#7CF0A7" />
      <SolidColorBrush x:Key="XgAccentPressedBrush" Color="#40B968" />
      <SolidColorBrush x:Key="XgAccentSoftBrush" Color="#2657E389" />

      <!-- Fluent control resource overrides for the dark surfaces. -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#0A121B" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0C1621" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0C1621" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1E2C3E" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2A3C53" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#57E389" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#0A121B" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#0C1621" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1E2C3E" />
      <SolidColorBrush x:Key="ButtonBackground" Color="#121C28" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#172333" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0E1620" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1E2C3E" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#2A3C53" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ===================== Typography ===================== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource XgBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextBrush}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextBrush}" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextBrush}" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.keycap">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextSecondaryBrush}" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="0.7" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource XgTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource XgTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource XgAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextBrush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextSecondaryBrush}" />
  </Style>

  <!-- ===================== Surfaces ===================== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource XgSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource XgBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.card.tight">
    <Setter Property="Padding" Value="14" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource XgInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource XgBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource XgBorderBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.stat">
    <Setter Property="Background" Value="{DynamicResource XgSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource XgBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource XgAccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,4" />
  </Style>
  <Style Selector="Border.warning">
    <Setter Property="Background" Value="{DynamicResource XgWarningSoftBrush}" />
    <Setter Property="BorderBrush" Value="#40F2B84B" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource XgOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource XgBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="BoxShadow" Value="0 12 30 0 #80000000" />
  </Style>

  <!-- ===================== Buttons ===================== -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource XgAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource XgAccentTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource XgAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource XgAccentTextBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource XgAccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource XgAccentTextBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource XgSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextMutedBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource XgBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource XgSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource XgBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextBrush}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource XgSurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextBrush}" />
  </Style>

  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource XgSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextBrush}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource XgErrorSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource XgErrorBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,9" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#40FF6B7D" />
    <Setter Property="Foreground" Value="#FFC3CB" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.38" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource XgAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource XgAccentHoverBrush}" />
  </Style>

  <!-- ===================== Navigation ===================== -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource XgSurfaceHoverBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource XgAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource XgTextBrush}" />
  </Style>

  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ===================== Accent swatches ===================== -->
  <Style Selector="ListBox.swatches">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ===================== Inputs ===================== -->
  <Style Selector="TextBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="TextBox.path">
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!-- ===================== Tooltips ===================== -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource XgSurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource XgTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource XgBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="12" />
  </Style>
</Styles>
