<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>XGrid.Frontend.Avalonia</RootNamespace>
    <AssemblyName>XGrid.Frontend.Avalonia</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- The source-generated LibraryImport marshalling for the host console
         attachment uses unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- UI types are not a public API surface; XAML is the documentation. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Required by Avalonia's Win32 native-control host (the embedded core display). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- UI code must resume on the Avalonia dispatcher after awaits. -->
    <NoWarn>$(NoWarn);MA0004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" VersionOverride="12.2.0" />
    <PackageReference Include="Avalonia.Desktop" VersionOverride="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" VersionOverride="12.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" VersionOverride="12.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" VersionOverride="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XGrid.Core.Xemu\XGrid.Core.Xemu.csproj" />
    <ProjectReference Include="..\XGrid.Input\XGrid.Input.csproj" />
    <ProjectReference Include="..\XGrid.Xbe\XGrid.Xbe.csproj" />
    <ProjectReference Include="..\XGrid.XboxFs\XGrid.XboxFs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
