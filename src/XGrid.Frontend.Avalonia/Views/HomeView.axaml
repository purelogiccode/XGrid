<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XGrid.Frontend.Avalonia.ViewModels"
             xmlns:local="using:XGrid.Frontend.Avalonia"
             xmlns:views="using:XGrid.Frontend.Avalonia.Views"
             x:Class="XGrid.Frontend.Avalonia.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <Grid Name="PageRoot" RowDefinitions="Auto,*,Auto" RowSpacing="10">

    <!-- ===================== Game view header ===================== -->
    <Border Grid.Row="0" Background="{DynamicResource XgSurfaceBrush}"
            BorderBrush="{DynamicResource XgBorderBrush}" BorderThickness="1"
            CornerRadius="4" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Shell.CurrentGameTitle}" Classes="sectionTitle" FontSize="14" />
          <TextBlock Text="{Binding Shell.HomeDetail}" Classes="caption" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <StackPanel Spacing="1" HorizontalAlignment="Right">
            <TextBlock Text="SPEED" Classes="caption" FontSize="9.5" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding Shell.Mips, StringFormat={}{0:0.0} MIPS}" Classes="mono" FontSize="11" />
          </StackPanel>
          <StackPanel Spacing="1" HorizontalAlignment="Right">
            <TextBlock Text="FRAMES" Classes="caption" FontSize="9.5" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding Shell.Frames, StringFormat={}{0:N0}}" Classes="mono" FontSize="11" />
          </StackPanel>
          <StackPanel Spacing="1" HorizontalAlignment="Right">
            <TextBlock Text="FPS" Classes="caption" FontSize="9.5" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding Shell.Fps, StringFormat={}{0:0.0}}" Classes="mono" FontSize="11" />
          </StackPanel>
          <Border Classes="badge" VerticalAlignment="Center">
            <TextBlock Text="{Binding Shell.StatusText}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== The picture ===================== -->
    <Border Grid.Row="1"
            Background="#050608"
            BorderBrush="{DynamicResource XgBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            ClipToBounds="True"
            MinHeight="320">
      <Grid>
        <Image Source="{Binding Shell.FrameBitmap}"
               Stretch="Uniform"
               RenderOptions.BitmapInterpolationMode="HighQuality" />

        <!-- The xemu core paints into this native surface with its own
             swapchain; the shell never copies a frame. -->
        <views:XemuDisplayHost x:Name="CoreDisplay"
                               IsVisible="{Binding Shell.ShowCoreDisplay}" />

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    IsVisible="{Binding !Shell.HasFrame}">
          <Grid Width="64" Height="64">
            <Ellipse Stroke="{DynamicResource XgBorderStrongBrush}" StrokeThickness="1.5" />
            <Ellipse Stroke="{DynamicResource XgAccentBrush}"
                     StrokeThickness="1.5"
                     Width="46"
                     Height="46"
                     Opacity="0.7" />
            <Path Data="M27 27 L49 49 M49 27 L27 49"
                  Stroke="{DynamicResource XgAccentBrush}"
                  StrokeThickness="2.6"
                  StrokeLineCap="Round" />
          </Grid>
          <TextBlock Text="{Binding Shell.FramePlaceholder}"
                     Classes="muted"
                     TextAlignment="Center"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Shell.DisplayCaption}"
                     Classes="caption"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== Transport strip ===================== -->
    <StackPanel Grid.Row="2" Spacing="8">
      <Border Classes="warning" IsVisible="{Binding ShowSetupWarning}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{x:Static local:AppIcons.Warning}"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource XgWarningBrush}" />
          <TextBlock Grid.Column="1"
                     Margin="10,0"
                     VerticalAlignment="Center"
                     Text="XGrid does not ship Microsoft firmware. Choose your own Xbox BIOS image before powering on." />
          <Button Grid.Column="2" Classes="ghost" Command="{Binding OpenSettingsCommand}" Content="Open settings" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="accent" Command="{Binding TogglePowerCommand}"
                  ToolTip.Tip="Power on or off (F5)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{x:Static local:AppIcons.Power}" Width="14" Height="14"
                        Foreground="{DynamicResource XgAccentTextBrush}" />
              <TextBlock Text="{Binding Shell.PowerButtonText}"
                         Foreground="{DynamicResource XgAccentTextBrush}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Classes="chrome" Command="{Binding TogglePauseCommand}"
                  IsEnabled="{Binding Shell.IsRunning}"
                  ToolTip.Tip="Pause or resume (F6)">
            <Panel>
              <PathIcon Data="{x:Static local:AppIcons.Pause}" Width="13" Height="13"
                        IsVisible="{Binding !Shell.IsPaused}" />
              <PathIcon Data="{x:Static local:AppIcons.Play}" Width="13" Height="13"
                        IsVisible="{Binding Shell.IsPaused}" />
            </Panel>
          </Button>
          <Button Classes="chrome" Command="{Binding StopCommand}"
                  IsEnabled="{Binding Shell.IsRunning}"
                  ToolTip.Tip="Stop the console">
            <PathIcon Data="{x:Static local:AppIcons.Stop}" Width="13" Height="13" />
          </Button>
          <Button Classes="chrome" Command="{Binding StepFrameCommand}"
                  IsEnabled="{Binding Shell.IsPaused}"
                  ToolTip.Tip="Advance one frame">
            <TextBlock Text="Frame step" FontSize="11.5" />
          </Button>

          <Border Width="1" Margin="6,4" Background="{DynamicResource XgBorderBrush}" />

          <Button Classes="chrome" Command="{Binding ChooseDiscCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static local:AppIcons.Disc}" Width="13" Height="13" />
              <TextBlock Text="Open disc" FontSize="11.5" />
            </StackPanel>
          </Button>
          <Button Classes="chrome" Command="{Binding SaveStateCommand}" IsEnabled="{Binding Shell.IsRunning}">
            <TextBlock Text="Save state" FontSize="11.5" />
          </Button>
          <Button Classes="chrome" Command="{Binding LoadStateCommand}" IsEnabled="{Binding Shell.IsRunning}">
            <TextBlock Text="Load state" FontSize="11.5" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6"
                      IsVisible="{Binding Shell.HasCurrentGame}">
            <TextBlock Text="{Binding Shell.CurrentGameTitle}" FontSize="11.5" />
            <TextBlock Text="{Binding Shell.CurrentGameFormat}" Classes="caption" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding Shell.Eip}" Classes="mono" FontSize="10.5"
                     ToolTip.Tip="Guest instruction pointer" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
