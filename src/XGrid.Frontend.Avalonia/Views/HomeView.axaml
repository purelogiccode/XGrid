<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XGrid.Frontend.Avalonia.ViewModels"
             xmlns:local="using:XGrid.Frontend.Avalonia"
             xmlns:views="using:XGrid.Frontend.Avalonia.Views"
             x:Class="XGrid.Frontend.Avalonia.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <Grid Name="PageRoot" RowDefinitions="Auto,*,Auto" RowSpacing="{Binding Shell.HomeRowSpacing}">

    <!-- ===================== Game view header ===================== -->
    <Border Grid.Row="0" Background="{DynamicResource XgSurfaceBrush}"
            BorderBrush="{DynamicResource XgBorderBrush}" BorderThickness="1"
            CornerRadius="4" Padding="12,8"
            IsVisible="{Binding !Shell.IsFullscreen}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Shell.CurrentGameTitle}" Classes="sectionTitle" FontSize="14" />
          <TextBlock Text="{Binding Shell.HomeDetail}" Classes="caption" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <StackPanel Spacing="1" HorizontalAlignment="Right">
            <TextBlock Text="RENDERER" Classes="caption" FontSize="9.5" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding Shell.RendererLabel}" Classes="mono" FontSize="11" />
          </StackPanel>
          <Border Classes="badge" VerticalAlignment="Center">
            <TextBlock Text="{Binding Shell.StatusText}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== The picture ===================== -->
    <Border Grid.Row="1"
            Background="#050608"
            BorderBrush="{DynamicResource XgBorderBrush}"
            BorderThickness="{Binding Shell.PictureBorderThickness}"
            CornerRadius="{Binding Shell.PictureCornerRadius}"
            ClipToBounds="True"
            MinHeight="320"
            ToolTip.Tip="The emulated console's picture">
      <Grid>
        <!-- Powered-off state. The core owns the picture while running, so this
             panel is only shown when no core window covers it. -->
        <Grid IsVisible="{Binding Shell.ShowPoweredOffPanel}">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="12"
                      MaxWidth="420">
            <Image Source="/Assets/xgrid-icon.png"
                   Width="176"
                   Height="176"
                   Stretch="Uniform"
                   Opacity="0.18"
                   HorizontalAlignment="Center"
                   ToolTip.Tip="XGrid" />
            <TextBlock Text="Console powered off"
                       Classes="sectionTitle"
                       FontSize="20"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Press Power or F5 to start the Xbox dashboard."
                       Classes="muted"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
            <Button Classes="accent"
                    Command="{Binding TogglePowerCommand}"
                    HorizontalAlignment="Center"
                    ToolTip.Tip="Power on the console (F5)">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{x:Static local:AppIcons.Power}"
                          Width="14"
                          Height="14"
                          Foreground="{DynamicResource XgAccentTextBrush}" />
                <TextBlock Text="Power on"
                           Foreground="{DynamicResource XgAccentTextBrush}"
                           FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- The core's own swapchain paints into this native child. Avalonia
             never copies, filters, overlays or redraws a frame. -->
        <Grid x:Name="CoreDisplayContainer"
              IsVisible="{Binding Shell.ShowCoreDisplay}" />

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    IsVisible="{Binding Shell.ShowExternalDisplayHint}">
          <TextBlock Text="The emulator window is open outside XGrid on this platform."
                     Classes="muted"
                     TextAlignment="Center"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Native in-window embedding is available on Windows."
                     Classes="caption"
                     TextAlignment="Center"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== Transport strip ===================== -->
    <StackPanel Grid.Row="2" Spacing="8" IsVisible="{Binding !Shell.IsFullscreen}">
      <Border Classes="warning" IsVisible="{Binding ShowSetupWarning}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{x:Static local:AppIcons.Warning}"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource XgWarningBrush}" />
          <TextBlock Grid.Column="1"
                     Margin="10,0"
                     VerticalAlignment="Center"
                     Text="XGrid does not ship Microsoft firmware. Choose your own Xbox BIOS image before powering on." />
          <Button Grid.Column="2" Classes="ghost" Command="{Binding OpenSettingsCommand}" Content="Open settings"
                  ToolTip.Tip="Open the settings page to choose a BIOS image" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="accent" Command="{Binding TogglePowerCommand}"
                  ToolTip.Tip="Power on or off (F5)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{x:Static local:AppIcons.Power}" Width="14" Height="14"
                        Foreground="{DynamicResource XgAccentTextBrush}" />
              <TextBlock Text="{Binding Shell.PowerButtonText}"
                         Foreground="{DynamicResource XgAccentTextBrush}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button Classes="chrome" Command="{Binding StopCommand}"
                  IsEnabled="{Binding Shell.IsRunning}"
                  ToolTip.Tip="Stop the console">
            <PathIcon Data="{x:Static local:AppIcons.Stop}" Width="13" Height="13" />
          </Button>

          <Border Width="1" Margin="6,4" Background="{DynamicResource XgBorderBrush}" />

          <Button Classes="chrome" Command="{Binding ChooseDiscCommand}"
                  ToolTip.Tip="Choose the disc that power-on will boot">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static local:AppIcons.Disc}" Width="13" Height="13" />
              <TextBlock Text="Open disc" FontSize="11.5" />
            </StackPanel>
          </Button>

          <Border Width="1" Margin="6,4" Background="{DynamicResource XgBorderBrush}" />

          <Button Classes="chrome"
                  Command="{Binding Shell.QuickSaveCommand}"
                  IsEnabled="{Binding Shell.HasSaveStates}"
                  ToolTip.Tip="{Binding Shell.SaveStateHint}">
            <TextBlock Text="Save state" FontSize="11.5" />
          </Button>
          <Button Classes="chrome"
                  Command="{Binding Shell.QuickLoadCommand}"
                  IsEnabled="{Binding Shell.HasSaveStates}"
                  ToolTip.Tip="{Binding Shell.LoadStateHint}">
            <TextBlock Text="Load state" FontSize="11.5" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6"
                      IsVisible="{Binding Shell.HasCurrentGame}">
            <TextBlock Text="{Binding Shell.CurrentGameTitle}" FontSize="11.5" />
            <TextBlock Text="{Binding Shell.CurrentGameFormat}" Classes="caption" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding Shell.RunStateLabel}" Classes="mono" FontSize="10.5" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
