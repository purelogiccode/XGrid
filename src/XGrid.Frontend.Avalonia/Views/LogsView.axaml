<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XGrid.Frontend.Avalonia.ViewModels"
             xmlns:conv="using:XGrid.Frontend.Avalonia.Converters"
             xmlns:model="using:XGrid.Frontend.Avalonia.Models"
             xmlns:local="using:XGrid.Frontend.Avalonia"
             x:Class="XGrid.Frontend.Avalonia.Views.LogsView"
             x:DataType="vm:LogsViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,14" ColumnSpacing="12">
      <ComboBox Width="150"
                ItemsSource="{Binding Filters}"
                SelectedItem="{Binding SelectedFilter, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="vm:LogFilterOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <CheckBox Grid.Column="1"
                Content="Auto-scroll"
                IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                VerticalAlignment="Center" />

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost" Command="{Binding CopyLogCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{x:Static local:AppIcons.Copy}" Width="13" Height="13" />
            <TextBlock Text="Copy" />
          </StackPanel>
        </Button>
        <Button Classes="danger" Command="{Binding ClearCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{x:Static local:AppIcons.Close}" Width="12" Height="12" />
            <TextBlock Text="Clear" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Classes="card" Padding="0">
      <Grid>
        <ListBox Name="LogList"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemsSource="{Binding Entries}"
                 Padding="8"
                 IsVisible="{Binding !IsEmpty}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="model:LogEntry">
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Margin="6,3">
                <TextBlock Text="{Binding TimeText}"
                           Classes="mono"
                           FontSize="11"
                           Foreground="{DynamicResource XgTextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding LevelText}"
                           Classes="mono"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{Binding Level, Converter={x:Static conv:LogLevelBrushConverter.Instance}}"
                           VerticalAlignment="Center"
                           Width="42" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Message}"
                           Classes="mono"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    IsVisible="{Binding IsEmpty}">
          <Grid Width="64" Height="64">
            <Ellipse Stroke="{DynamicResource XgBorderStrongBrush}" StrokeThickness="1.5" />
            <PathIcon Data="{x:Static local:AppIcons.Logs}"
                      Width="24"
                      Height="24"
                      Foreground="{DynamicResource XgTextMutedBrush}" />
          </Grid>
          <TextBlock Text="No activity yet" Classes="muted" HorizontalAlignment="Center" />
          <TextBlock Text="Boot messages and emulator diagnostics appear here."
                     Classes="hint"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
