<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XGrid.Frontend.Avalonia.ViewModels"
             xmlns:local="using:XGrid.Frontend.Avalonia"
             x:Class="XGrid.Frontend.Avalonia.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <UserControl.Styles>
    <Style Selector="Button.favorite">
      <Setter Property="Background" Value="#B3120E12" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="#F2C94C" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.favorite:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#D9222027" />
    </Style>
    <Style Selector="Button.favorite.small">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="3,0" />
    </Style>
    <Style Selector="TextBlock.libraryMeta">
      <Setter Property="Foreground" Value="{DynamicResource XgTextMutedBrush}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- ===================== Library toolbar ===================== -->
    <Border Grid.Row="0"
            Padding="14,8"
            Margin="0,0,0,8"
            Background="{DynamicResource XgSurfaceBrush}"
            BorderBrush="{DynamicResource XgBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="Game List" Classes="h3" ToolTip.Tip="Games found in the configured library folders." />
          <Border Classes="badge" VerticalAlignment="Center" ToolTip.Tip="Number of games in your library.">
            <TextBlock Text="{Binding CountText}" />
          </Border>
        </StackPanel>

        <Grid Grid.Column="1" MaxWidth="420" Margin="24,0" VerticalAlignment="Center">
          <PathIcon Data="{x:Static local:AppIcons.Search}"
                    Width="14"
                    Height="14"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Foreground="{DynamicResource XgTextMutedBrush}" />
          <TextBox Classes="search"
                   Padding="32,6,10,6"
                   PlaceholderText="Search games…"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   ToolTip.Tip="Filter by title, path, format, title id, year or publisher." />
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ComboBox Width="118"
                    SelectedIndex="{Binding FilterIndex, Mode=TwoWay}"
                    ToolTip.Tip="Show all games, favorites, played games or unplayed games.">
            <ComboBoxItem Content="All games" />
            <ComboBoxItem Content="Favorites" />
            <ComboBoxItem Content="Played" />
            <ComboBoxItem Content="Unplayed" />
          </ComboBox>
          <ComboBox Width="146"
                    SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                    ToolTip.Tip="Sort by title, recent play, play time, release year or publisher.">
            <ComboBoxItem Content="Title" />
            <ComboBoxItem Content="Recently played" />
            <ComboBoxItem Content="Most played" />
            <ComboBoxItem Content="Release year" />
            <ComboBoxItem Content="Publisher" />
          </ComboBox>
          <TextBlock Text="Icon size"
                     Classes="caption"
                     VerticalAlignment="Center"
                     ToolTip.Tip="Thumbnail size used by the tile grid." />
          <Slider x:Name="IconSizeSlider"
                  Width="132"
                  Minimum="128"
                  Maximum="384"
                  TickFrequency="8"
                  IsSnapToTickEnabled="True"
                  Value="{Binding IconSize, Mode=TwoWay}"
                  ValueChanged="OnIconSizeValueChanged"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Adjust the size of game cards in the grid view." />
          <Button Classes="ghost"
                  Classes.active="{Binding IsGridView}"
                  Command="{Binding ShowGridCommand}"
                  Padding="9,6"
                  ToolTip.Tip="Show games as thumbnail tiles">
            <PathIcon Data="{x:Static local:AppIcons.Library}" Width="14" Height="14" />
          </Button>
          <Button Classes="ghost"
                  Classes.active="{Binding IsListView}"
                  Command="{Binding ShowListCommand}"
                  Padding="9,6"
                  ToolTip.Tip="Show games as a detailed list">
            <PathIcon Data="{x:Static local:AppIcons.List}" Width="14" Height="14" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== Grid and list ===================== -->
    <Grid Grid.Row="1">
      <ListBox x:Name="GridLibraryList"
               Classes="library libraryGrid"
               IsVisible="{Binding ShowGameTiles}"
               ItemsSource="{Binding Games}"
               SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
               DoubleTapped="OnGameDoubleTapped"
               KeyDown="OnGameKeyDown"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ToolTip.Tip="Select a game. Double-click or press Enter to boot it.">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:GameListItem">
            <Border Classes="card libraryCard"
                    Width="{DynamicResource LibraryCardWidth}"
                    ToolTip.Tip="{Binding Tip}">
              <StackPanel>
                <Border Classes="coverFrame"
                        Height="{DynamicResource LibraryCardImageHeight}">
                  <Panel>
                    <PathIcon Data="{x:Static local:AppIcons.Disc}"
                              Width="36"
                              Height="36"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsVisible="{Binding !HasCover}"
                              Foreground="{DynamicResource XgAccentBrush}" />
                    <Image Source="{Binding Cover}"
                           Stretch="Uniform"
                           IsVisible="{Binding HasCover}"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <Button Classes="favorite"
                            Content="{Binding FavoriteGlyph}"
                            Command="{Binding ToggleFavoriteCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="5"
                            ToolTip.Tip="Add or remove this game from favorites." />
                    <Border Classes="pill"
                            Padding="7,2"
                            Margin="7"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            IsVisible="{Binding IsLaunchable}">
                      <TextBlock Text="{Binding FormatText}"
                                 FontSize="9.5"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource XgAccentBrush}" />
                    </Border>
                  </Panel>
                </Border>
                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           FontSize="12.5"
                           Margin="2,8,2,3"
                           Height="34"
                           MaxLines="2"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding MetadataText}"
                           Classes="libraryMeta"
                           Margin="2,0,2,2"
                           ToolTip.Tip="{Binding DetailText}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="2,0,2,1">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FormatText}" Classes="libraryMeta" />
                    <TextBlock Text="{Binding ShortTitleIdText}"
                               Classes="libraryMeta"
                               IsVisible="{Binding HasDistinctTitleId}" />
                    <TextBlock Text="{Binding PlaytimeText}" Classes="libraryMeta" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="{Binding SizeText}"
                             Classes="libraryMeta"
                             HorizontalAlignment="Right" />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ListBox x:Name="ListLibraryList"
               Classes="library libraryList"
               IsVisible="{Binding ShowGameRows}"
               ItemsSource="{Binding Games}"
               SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
               DoubleTapped="OnGameDoubleTapped"
               KeyDown="OnGameKeyDown"
               ToolTip.Tip="Select a game. Double-click or press Enter to boot it.">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:GameListItem">
            <Border Classes="card libraryCard" Padding="4" ToolTip.Tip="{Binding Tip}">
              <Grid ColumnDefinitions="54,*,66,80,92,116" ColumnSpacing="8">
                <Border Classes="coverFrame" Width="48" Height="48" VerticalAlignment="Center">
                  <Panel>
                    <PathIcon Data="{x:Static local:AppIcons.Disc}"
                              Width="20"
                              Height="20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsVisible="{Binding !HasCover}"
                              Foreground="{DynamicResource XgAccentBrush}" />
                    <Image Source="{Binding Cover}"
                           Stretch="Uniform"
                           IsVisible="{Binding HasCover}"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <Button Classes="favorite small"
                            Content="{Binding FavoriteGlyph}"
                            Command="{Binding ToggleFavoriteCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="1"
                            ToolTip.Tip="Add or remove this game from favorites." />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,6,0" Spacing="1">
                  <TextBlock Text="{Binding Title}"
                             FontWeight="SemiBold"
                             FontSize="12.5"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding MetadataText}"
                             Classes="libraryMeta"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Path}"
                             Classes="libraryMeta"
                             FontSize="10"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding FormatText}"
                           Classes="libraryMeta"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="{Binding SizeText}"
                           Classes="libraryMeta"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,8,0" />
                <TextBlock Grid.Column="4"
                           Text="{Binding PlaytimeText}"
                           Classes="libraryMeta"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,8,0" />
                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                  <Border Classes="badge" IsVisible="{Binding IsExecutable}">
                    <TextBlock Text="XBE" />
                  </Border>
                  <Border Classes="badge" IsVisible="{Binding HasDistinctTitleId}"
                          ToolTip.Tip="{Binding TitleIdText}">
                    <TextBlock Text="{Binding TitleIdText}" />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- ===================== Empty state ===================== -->
      <Border Classes="card" IsVisible="{Binding ShowEmptyState}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    MaxWidth="440">
          <PathIcon Data="{x:Static local:AppIcons.Library}"
                    Width="52"
                    Height="52"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource XgTextMutedBrush}" />
          <TextBlock Text="{Binding EmptyTitle}"
                     Classes="h2"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyDetail}"
                     Classes="body"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Classes="primary" Command="{Binding AddFolderCommand}"
                    ToolTip.Tip="Add a folder to scan for games">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{x:Static local:AppIcons.Folder}" Width="13" Height="13" />
                <TextBlock Text="Add folder" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Command="{Binding RescanCommand}" Content="Rescan"
                    ToolTip.Tip="Rescan the configured folders" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===================== Status ===================== -->
    <Border Grid.Row="2"
            Margin="0,8,0,0"
            Padding="2,0"
            IsVisible="{Binding ShowStatus}"
            Background="Transparent">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ProgressBar Width="90"
                       Height="3"
                       IsIndeterminate="True"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsScanning}" />
          <ProgressBar Width="90"
                       Height="3"
                       IsIndeterminate="True"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsResolvingCovers}" />
          <TextBlock Text="{Binding StatusText}"
                     Classes="caption"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="2"
                   Text="{Binding CoverStatusText}"
                   Classes="caption"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="460"
                   ToolTip.Tip="Online cover catalog and download status." />
      </Grid>
    </Border>
  </Grid>
</UserControl>
