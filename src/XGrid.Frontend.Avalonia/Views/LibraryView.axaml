<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XGrid.Frontend.Avalonia.ViewModels"
             xmlns:local="using:XGrid.Frontend.Avalonia"
             x:Class="XGrid.Frontend.Avalonia.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- ===================== Toolbar ===================== -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBox Width="300"
                 PlaceholderText="Search games…"
                 Text="{Binding SearchText, Mode=TwoWay}"
                 VerticalAlignment="Center"
                 ToolTip.Tip="Search the library by title or folder" />
        <Button Classes="primary" Command="{Binding AddFolderCommand}"
                ToolTip.Tip="Add a folder to scan for games">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{x:Static local:AppIcons.Folder}" Width="14" Height="14" />
            <TextBlock Text="Add folder" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding RescanCommand}"
                ToolTip.Tip="Rescan library folders for new games">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{x:Static local:AppIcons.Refresh}" Width="14" Height="14" />
            <TextBlock Text="Rescan" />
          </StackPanel>
        </Button>
        <Button Classes="ghost"
                Command="{Binding Shell.OpenCoversFolderCommand}"
                ToolTip.Tip="Add cover images here; name them after the title or title id.">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{x:Static local:AppIcons.Folder}" Width="14" Height="14" />
            <TextBlock Text="Covers" />
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="ghost"
                  Classes.active="{Binding IsGridView}"
                  Command="{Binding ShowGridCommand}"
                  Padding="10,7"
                  ToolTip.Tip="Show games as thumbnail tiles">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static local:AppIcons.Library}" Width="14" Height="14" />
              <TextBlock Text="Tiles" />
            </StackPanel>
          </Button>
          <Button Classes="ghost"
                  Classes.active="{Binding IsListView}"
                  Command="{Binding ShowListCommand}"
                  Padding="10,7"
                  ToolTip.Tip="Show games as a detailed list">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static local:AppIcons.List}" Width="14" Height="14" />
              <TextBlock Text="List" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Border Width="1" Height="18"
                Background="{DynamicResource XgBorderBrush}"
                VerticalAlignment="Center" />
        <ProgressBar Width="120"
                     Height="3"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsScanning}"
                     VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}"
                   Classes="caption"
                   MaxWidth="420"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- ===================== Recently played ===================== -->
    <Border Grid.Row="1" Classes="card" Margin="0,0,0,14" IsVisible="{Binding HasRecentGames}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Recently played" Classes="h3" />
            <TextBlock Text="Your last launches, newest first." Classes="hint" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="ghost"
                  Command="{Binding ClearRecentGamesCommand}"
                  Content="Clear"
                  ToolTip.Tip="Remove every recently played entry" />
        </Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding RecentGames}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:RecentGameItem">
                <Button Classes="subtle"
                        Padding="12,8"
                        Command="{Binding LaunchCommand}"
                        ToolTip.Tip="{Binding Path}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LastPlayedText}"
                               Classes="caption"
                               FontSize="10.5" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- ===================== Empty state ===================== -->
    <Border Grid.Row="2" Classes="card" IsVisible="{Binding ShowEmptyState}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="14"
                  MaxWidth="440">
        <Grid Width="72" Height="72">
          <Ellipse Stroke="{DynamicResource XgBorderStrongBrush}" StrokeThickness="1.5" />
          <PathIcon Data="{x:Static local:AppIcons.Library}"
                    Width="28"
                    Height="28"
                    Foreground="{DynamicResource XgAccentBrush}" />
        </Grid>
        <TextBlock Text="{Binding EmptyTitle}" Classes="h2" HorizontalAlignment="Center" />
        <TextBlock Classes="body"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{Binding EmptyDetail}" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Button Classes="primary" Command="{Binding AddFolderCommand}"
                  ToolTip.Tip="Add a folder to scan for games">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static local:AppIcons.Folder}" Width="14" Height="14" />
              <TextBlock Text="Add a folder" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding RescanCommand}" Content="Rescan"
                  ToolTip.Tip="Rescan library folders for new games" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ===================== Game tiles ===================== -->
    <ScrollViewer Grid.Row="2"
                  IsVisible="{Binding ShowGameTiles}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  ToolTip.Tip="Games found in your library folders">
      <ItemsControl ItemsSource="{Binding Games}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:GameListItem">
            <Button Classes="subtle"
                    Width="176"
                    Margin="0,0,8,8"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding LaunchCommand}"
                    IsEnabled="{Binding IsLaunchable}"
                    ToolTip.Tip="{Binding Title}"
                    ToolTip.ShowOnDisabled="True">
              <Border Classes="card gameTile">
                <StackPanel Spacing="6">
                  <Border Classes="coverFrame" Height="208">
                    <Panel>
                      <PathIcon Data="{x:Static local:AppIcons.Disc}"
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !HasCover}"
                                Foreground="{DynamicResource XgAccentBrush}" />
                      <Image Source="{Binding Cover}"
                             Stretch="Uniform"
                             IsVisible="{Binding HasCover}"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                      <Border Classes="pill"
                              Padding="7,2"
                              Margin="7"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              IsVisible="{Binding IsLaunchable}">
                        <TextBlock Text="{Binding FormatText}"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource XgAccentBrush}" />
                      </Border>
                    </Panel>
                  </Border>
                  <TextBlock Text="{Binding Title}"
                             FontSize="12.5"
                             FontWeight="SemiBold"
                             Height="34"
                             MaxLines="2"
                             TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock Text="{Binding FormatText}"
                               Classes="caption"
                               FontSize="10.5"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SizeText}"
                               Classes="muted"
                               FontSize="10.5"
                               VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- ===================== Game rows ===================== -->
    <ListBox Grid.Row="2"
             Classes="rows"
             ItemsSource="{Binding Games}"
             IsVisible="{Binding ShowGameRows}"
             SelectionMode="Single"
             ToolTip.Tip="Games found in your library folders">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:GameListItem">
          <Border Classes="card tight" Padding="14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Width="54"
                      Height="72"
                      CornerRadius="8"
                      ClipToBounds="True"
                      Background="{DynamicResource XgAccentSoftBrush}"
                      VerticalAlignment="Center">
                <Grid>
                  <PathIcon Data="{x:Static local:AppIcons.Disc}"
                            Width="23"
                            Height="23"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !HasCover}"
                            Foreground="{DynamicResource XgAccentBrush}" />
                  <Image Source="{Binding Cover}"
                         Stretch="UniformToFill"
                         IsVisible="{Binding HasCover}"
                         RenderOptions.BitmapInterpolationMode="HighQuality" />
                </Grid>
              </Border>

              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Folder}"
                           Classes="caption"
                           FontSize="10.5"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>

              <StackPanel Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="10"
                          VerticalAlignment="Center">
                <Border Classes="pill" Padding="8,3" IsVisible="{Binding IsLaunchable}">
                  <TextBlock Text="{Binding FormatText}"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource XgAccentBrush}" />
                </Border>
                <Border Background="{DynamicResource XgSurfaceAltBrush}"
                        CornerRadius="999"
                        Padding="8,3"
                        IsVisible="{Binding IsExecutable}">
                  <TextBlock Text="XBE"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Classes="muted" />
                </Border>
                <TextBlock Text="{Binding TitleIdText}"
                           IsVisible="{Binding HasDistinctTitleId}"
                           Classes="muted"
                           FontSize="10.5"
                           VerticalAlignment="Center"
                           ToolTip.Tip="Per-title settings key on this certificate title id." />
                <TextBlock Text="{Binding SizeText}"
                           Classes="muted"
                           FontSize="12"
                           Width="78"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
                <Button Classes="primary"
                        Command="{Binding LaunchCommand}"
                        IsEnabled="{Binding IsLaunchable}"
                        ToolTip.Tip="Launch this game; loose XBE files need an ISO or CHD wrapper to boot"
                        ToolTip.ShowOnDisabled="True">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{x:Static local:AppIcons.Play}" Width="12" Height="12" />
                    <TextBlock Text="Play" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- ===================== Screenshots ===================== -->
    <Border Grid.Row="3" Classes="card" Margin="0,14,0,0" IsVisible="{Binding HasScreenshots}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel Spacing="2">
            <TextBlock Text="Screenshots" Classes="h3" />
            <TextBlock Text="Recent captures (F8). Click a picture to open it."
                       Classes="hint" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" Command="{Binding RefreshScreenshotsCommand}"
                  Content="Refresh" ToolTip.Tip="Re-read the screenshots folder" />
          <Button Grid.Column="2" Classes="ghost"
                  Command="{Binding Shell.OpenScreenshotsFolderCommand}"
                  Content="Open folder" ToolTip.Tip="Show the screenshots folder in the file manager" />
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      MaxHeight="132">
          <ItemsControl ItemsSource="{Binding Screenshots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ScreenshotItem">
                <Button Classes="subtle"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding OpenCommand}"
                        ToolTip.Tip="Open this screenshot in the default image viewer">
                  <StackPanel Spacing="4">
                    <Border Width="168"
                            Height="94"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Background="#050608">
                      <Image Source="{Binding Thumbnail}"
                             Stretch="UniformToFill"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Border>
                    <TextBlock Text="{Binding CapturedText}"
                               Classes="mono"
                               FontSize="10"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
