<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XGrid.Frontend.Avalonia.ViewModels"
        xmlns:models="using:XGrid.Frontend.Avalonia.Models"
        xmlns:views="using:XGrid.Frontend.Avalonia.Views"
        xmlns:local="using:XGrid.Frontend.Avalonia"
        x:Class="XGrid.Frontend.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="XGrid - Xbox Emulator"
        Icon="/Assets/xgrid-icon.png"
        Width="1280"
        Height="880"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource XgBackgroundBrush}">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!-- ===================== Menu bar ===================== -->
    <Menu Grid.Row="0" IsVisible="{Binding !IsFullscreen}">
      <MenuItem Header="File" ToolTip.Tip="Choose a disc image or leave XGrid.">
        <MenuItem Header="Open Disc..." InputGesture="Ctrl+O" Click="OnMenuOpenDisc"
                  ToolTip.Tip="Choose an ISO or CHD image and power the console on." />
        <MenuItem Header="Choose Disc Image..." Click="OnMenuChooseDisc"
                  ToolTip.Tip="Select the disc that the power button will boot." />
        <Separator />
        <MenuItem Header="Open Config Folder" Click="OnMenuOpenConfigFolder"
                  ToolTip.Tip="Show the folder with settings.json and the generated core configuration." />
        <MenuItem Header="Open Screenshots Folder" Click="OnMenuOpenScreenshotsFolder"
                  ToolTip.Tip="Show the folder that F8 writes captures to." />
        <Separator />
        <MenuItem Header="Exit" Click="OnMenuExit" ToolTip.Tip="Close XGrid." />
      </MenuItem>
      <MenuItem Header="Emulation" ToolTip.Tip="Power, stop, pause and save states.">
        <MenuItem Header="Power On / Off" InputGesture="F5" Click="OnMenuPower" />
        <MenuItem Header="Stop" Click="OnMenuStop" />
        <MenuItem Header="{Binding PauseButtonText}" InputGesture="P"
                  Command="{Binding TogglePauseCommand}"
                  ToolTip.Tip="Freeze the running machine and resume it where it stopped." />
        <MenuItem Header="Step One Frame" InputGesture="F10"
                  Command="{Binding StepFrameCommand}"
                  ToolTip.Tip="Advance a paused machine by one frame." />
        <Separator />
        <MenuItem Header="Save State" IsEnabled="{Binding HasSaveStates}"
                  ToolTip.Tip="Write the running machine to a slot on the hard disk image.">
          <MenuItem Header="{Binding QuickSaveHeader}" InputGesture="F6"
                    Command="{Binding QuickSaveCommand}" />
          <Separator />
          <MenuItem Header="Slot 1" Tag="1" Click="OnMenuSaveState" />
          <MenuItem Header="Slot 2" Tag="2" Click="OnMenuSaveState" />
          <MenuItem Header="Slot 3" Tag="3" Click="OnMenuSaveState" />
          <MenuItem Header="Slot 4" Tag="4" Click="OnMenuSaveState" />
        </MenuItem>
        <MenuItem Header="Load State" IsEnabled="{Binding HasSaveStates}"
                  ToolTip.Tip="Restore the machine from a slot and keep running.">
          <MenuItem Header="{Binding QuickLoadHeader}" InputGesture="F7"
                    Command="{Binding QuickLoadCommand}" />
          <Separator />
          <MenuItem Header="Slot 1" Tag="1" Click="OnMenuLoadState" />
          <MenuItem Header="Slot 2" Tag="2" Click="OnMenuLoadState" />
          <MenuItem Header="Slot 3" Tag="3" Click="OnMenuLoadState" />
          <MenuItem Header="Slot 4" Tag="4" Click="OnMenuLoadState" />
        </MenuItem>
        <MenuItem Header="Delete State" IsEnabled="{Binding HasSaveStates}"
                  ToolTip.Tip="Remove a slot from the hard disk image.">
          <MenuItem Header="Slot 1" Tag="1" Click="OnMenuDeleteState" />
          <MenuItem Header="Slot 2" Tag="2" Click="OnMenuDeleteState" />
          <MenuItem Header="Slot 3" Tag="3" Click="OnMenuDeleteState" />
          <MenuItem Header="Slot 4" Tag="4" Click="OnMenuDeleteState" />
        </MenuItem>
        <Separator />
        <MenuItem Header="Fullscreen" InputGesture="F11" Click="OnMenuFullscreen" />
      </MenuItem>
      <MenuItem Header="View" ToolTip.Tip="Switch pages, the log dock and the layout.">
        <MenuItem Header="Console" Click="OnMenuHome" />
        <MenuItem Header="Library" Click="OnMenuLibrary" />
        <MenuItem Header="Settings" Click="OnMenuSettings" />
        <MenuItem Header="Activity" Click="OnMenuLogs" />
        <Separator />
        <MenuItem Header="Save Screenshot" InputGesture="F8" Click="OnMenuScreenshot"
                  ToolTip.Tip="Write the current frame to the screenshots folder as a PNG." />
        <MenuItem Header="Show Log Dock" ToggleType="CheckBox" IsChecked="{Binding ShowLogDock}"
                  Click="OnMenuToggleLogDock" />
        <Separator />
        <MenuItem Header="Fullscreen" InputGesture="F11" Click="OnMenuFullscreen" />
      </MenuItem>
      <MenuItem Header="Help" ToolTip.Tip="About this build and the emulation core.">
        <MenuItem Header="About XGrid" Click="OnMenuAbout" />
      </MenuItem>
    </Menu>

    <!-- ===================== Toolbar ===================== -->
    <Border Grid.Row="1"
            Padding="8,4"
            IsVisible="{Binding !IsFullscreen}"
            Background="{DynamicResource XgToolbarBrush}"
            BorderBrush="{DynamicResource XgBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="toolbar" Click="OnMenuChooseDisc" ToolTip.Tip="Choose the disc image to boot">
            <StackPanel Spacing="2">
              <PathIcon Width="22" Height="22" HorizontalAlignment="Center" Data="{x:Static local:AppIcons.Disc}" />
              <TextBlock Text="Open" FontSize="10.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Click="OnMenuPower" ToolTip.Tip="Power the console on or off (F5)">
            <StackPanel Spacing="2">
              <PathIcon Width="22" Height="22" HorizontalAlignment="Center" Data="{x:Static local:AppIcons.Power}" />
              <TextBlock Text="Power" FontSize="10.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Click="OnMenuStop" ToolTip.Tip="Stop emulation">
            <StackPanel Spacing="2">
              <PathIcon Width="22" Height="22" HorizontalAlignment="Center" Data="{x:Static local:AppIcons.Stop}" />
              <TextBlock Text="Stop" FontSize="10.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar"
                  Command="{Binding TogglePauseCommand}"
                  ToolTip.Tip="{Binding PauseHint}">
            <StackPanel Spacing="2">
              <PathIcon Width="22" Height="22" HorizontalAlignment="Center" Data="{x:Static local:AppIcons.Pause}" />
              <TextBlock Text="{Binding PauseButtonText}" FontSize="10.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar"
                  Command="{Binding StepFrameCommand}"
                  ToolTip.Tip="{Binding StepFrameHint}">
            <StackPanel Spacing="2">
              <PathIcon Width="22" Height="22" HorizontalAlignment="Center" Data="{x:Static local:AppIcons.StepForward}" />
              <TextBlock Text="Step" FontSize="10.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Border Width="1" Margin="7,6" Background="{DynamicResource XgBorderBrush}" />

          <Button Classes="toolbar" Click="OnMenuLibrary" ToolTip.Tip="Game library">
            <StackPanel Spacing="2">
              <PathIcon Width="22" Height="22" HorizontalAlignment="Center" Data="{x:Static local:AppIcons.Library}" />
              <TextBlock Text="Library" FontSize="10.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Click="OnMenuSettings" ToolTip.Tip="Settings">
            <StackPanel Spacing="2">
              <PathIcon Width="22" Height="22" HorizontalAlignment="Center" Data="{x:Static local:AppIcons.Settings}" />
              <TextBlock Text="Config" FontSize="10.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Border Width="1" Margin="7,6" Background="{DynamicResource XgBorderBrush}" />

          <Button Classes="toolbar" Click="OnMenuToggleLogDock" ToolTip.Tip="Show or hide the log dock">
            <StackPanel Spacing="2">
              <PathIcon Width="22" Height="22" HorizontalAlignment="Center" Data="{x:Static local:AppIcons.Logs}" />
              <TextBlock Text="Logs" FontSize="10.5" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
          <Border Classes="badge" VerticalAlignment="Center" ToolTip.Tip="This build">
            <TextBlock Text="{Binding AppLabel}" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource XgAccentBrush}" />
            <TextBlock Text="{Binding RunStateLabel}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== Content ===================== -->
    <!-- Pages stay alive across navigation: the console page owns a native
         child window that must not be destroyed when the user opens settings. -->
    <Grid Grid.Row="2" Margin="16,14,16,14">
      <views:HomeView DataContext="{Binding Home}" IsVisible="{Binding IsActive}" />
      <views:LibraryView DataContext="{Binding Library}" IsVisible="{Binding IsActive}" />
      <views:SettingsView DataContext="{Binding Settings}" IsVisible="{Binding IsActive}" />
      <views:LogsView DataContext="{Binding Logs}" IsVisible="{Binding IsActive}" />
      <views:AboutView DataContext="{Binding About}" IsVisible="{Binding IsActive}" />
    </Grid>

    <!-- ===================== Log dock ===================== -->
    <Border Grid.Row="3"
            Height="180"
            IsVisible="{Binding ShowLogDock}"
            Background="{DynamicResource XgSurfaceBrush}"
            BorderBrush="{DynamicResource XgBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="10,3" Background="{DynamicResource XgSurfaceAltBrush}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Width="12" Height="12" Data="{x:Static local:AppIcons.Logs}"
                        Foreground="{DynamicResource XgTextMutedBrush}" />
              <TextBlock Text="Log" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="caption" Margin="12,0" VerticalAlignment="Center"
                       Text="{Binding LogEntries.Count, StringFormat={}{0:N0} entries}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
              <Button Classes="chrome" Content="Activity" Click="OnMenuLogs" ToolTip.Tip="Open the full activity page" />
              <Button Classes="chrome" Padding="6,4" Click="OnMenuToggleLogDock" ToolTip.Tip="Hide the log dock">
                <PathIcon Width="11" Height="11" Data="{x:Static local:AppIcons.Close}" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <ListBox x:Name="LogDockList" Grid.Row="1" Classes="log"
                 ItemsSource="{Binding LogEntries}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ToolTip.Tip="Recent diagnostic messages">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="models:LogEntry">
              <Grid ColumnDefinitions="Auto,Auto,*">
                <TextBlock Text="{Binding TimeText}" Classes="mono" FontSize="11"
                           Foreground="{DynamicResource XgTextMutedBrush}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding LevelText}" Classes="mono" FontSize="11"
                           Width="46" Margin="0,0,6,0" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" Classes="mono" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- ===================== Status bar ===================== -->
    <Border Grid.Row="4"
            Padding="10,4"
            Background="{DynamicResource XgStatusBarBrush}"
            BorderBrush="{DynamicResource XgBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                 Fill="{DynamicResource XgAccentBrush}" />
        <TextBlock Grid.Column="1" Classes="status" Text="{Binding StatusDetail}"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="Current status" />
        <TextBlock Grid.Column="2" Classes="status" Margin="12,0" Text="{Binding AppLabel}" />
        <TextBlock Grid.Column="3" Classes="status" Margin="12,0" Text="{Binding RendererLabel}" />
        <TextBlock Grid.Column="4" Classes="statusStrong" MinWidth="60" TextAlignment="Right"
                   Text="{Binding RunStateLabel}" />
      </Grid>
    </Border>

    <!-- ===================== Toast ===================== -->
    <Border Grid.Row="0" Grid.RowSpan="5"
            Classes="toast"
            IsVisible="{Binding IsToastVisible}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,24">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <PathIcon Data="{x:Static local:AppIcons.Check}"
                  Width="15"
                  Height="15"
                  Foreground="{DynamicResource XgAccentBrush}" />
        <TextBlock Text="{Binding ToastMessage}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
