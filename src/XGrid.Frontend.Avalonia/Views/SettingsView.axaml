<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XGrid.Frontend.Avalonia.ViewModels"
             xmlns:local="using:XGrid.Frontend.Avalonia"
             x:Class="XGrid.Frontend.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">

    <!-- ===================== Save bar ===================== -->
    <Border Grid.Row="0" Classes="card tight" Padding="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="Configuration" Classes="label" />
          <TextBlock Text="{Binding SettingsFolder}" Classes="mono" FontSize="10.5" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Command="{Binding OpenSettingsFolderCommand}"
                  ToolTip.Tip="Show the folder that holds settings.json">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{x:Static local:AppIcons.Folder}" Width="13" Height="13" />
              <TextBlock Text="Open folder" />
            </StackPanel>
          </Button>
          <Button Classes="primary" Command="{Binding SaveCommand}"
                  ToolTip.Tip="Write these settings to disk (Ctrl+S)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{x:Static local:AppIcons.Save}"
                        Width="13"
                        Height="13"
                        Foreground="{DynamicResource XgAccentTextBrush}" />
              <TextBlock Text="Save settings"
                         Foreground="{DynamicResource XgAccentTextBrush}"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== Sections ===================== -->
    <TabControl Grid.Row="1" Name="SettingsTabs" Classes="settings">

      <!-- ===================== System ===================== -->
      <TabItem Header="System" ToolTip.Tip="Firmware, storage, session and emulator options">
        <ScrollViewer>
          <StackPanel Spacing="16" MaxWidth="1040" HorizontalAlignment="Stretch">

            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Firmware" Classes="h3" />
                  <TextBlock Text="XGrid ships no Microsoft firmware. Provide your own legally obtained images."
                             Classes="hint" />
                </StackPanel>
                <Border Classes="divider" />

                <StackPanel Spacing="7">
                  <StackPanel Spacing="2">
                    <TextBlock Text="BIOS image" Classes="label" />
                    <TextBlock Text="Required. The retail MCPX BIOS (256 KB or 512 KB)." Classes="hint" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Classes="path"
                             Text="{Binding BiosPath, Mode=TwoWay}"
                             PlaceholderText="Path to the BIOS image"
                             ToolTip.Tip="Path to the retail MCPX BIOS image" />
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding BrowseBiosCommand}" Content="Browse…"
                            ToolTip.Tip="Choose the BIOS image file" />
                    <Button Grid.Column="2"
                            Classes="subtle icon"
                            Command="{Binding ClearFieldCommand}"
                            CommandParameter="bios"
                            ToolTip.Tip="Clear the BIOS path">
                      <PathIcon Data="{x:Static local:AppIcons.Close}" Width="13" Height="13" />
                    </Button>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{DynamicResource XgErrorBrush}"
                             IsVisible="{Binding ShowBiosWarning}" />
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{DynamicResource XgAccentBrush}"
                             IsVisible="{Binding BiosPathValid}" />
                    <TextBlock Text="{Binding BiosStatusText}" Classes="hint" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="7">
                  <StackPanel Spacing="2">
                    <TextBlock Text="MCPX boot ROM" Classes="label" />
                    <TextBlock Text="Optional 512-byte MCPX ROM (mcpx_1.0.bin)." Classes="hint" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Classes="path"
                             Text="{Binding McpxRomPath, Mode=TwoWay}"
                             PlaceholderText="Optional"
                             ToolTip.Tip="Path to the optional MCPX boot ROM" />
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding BrowseMcpxCommand}" Content="Browse…"
                            ToolTip.Tip="Choose the MCPX boot ROM file" />
                    <Button Grid.Column="2"
                            Classes="subtle icon"
                            Command="{Binding ClearFieldCommand}"
                            CommandParameter="mcpx"
                            ToolTip.Tip="Clear the MCPX ROM path">
                      <PathIcon Data="{x:Static local:AppIcons.Close}" Width="13" Height="13" />
                    </Button>
                  </Grid>
                </StackPanel>

                <StackPanel Spacing="7">
                  <StackPanel Spacing="2">
                    <TextBlock Text="EEPROM image" Classes="label" />
                    <TextBlock Text="Optional 256-byte EEPROM dump. Uses a blank image when omitted." Classes="hint" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Classes="path"
                             Text="{Binding EepromPath, Mode=TwoWay}"
                             PlaceholderText="Optional"
                             ToolTip.Tip="Path to the optional EEPROM image" />
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding BrowseEepromCommand}" Content="Browse…"
                            ToolTip.Tip="Choose the EEPROM image file" />
                    <Button Grid.Column="2"
                            Classes="subtle icon"
                            Command="{Binding ClearFieldCommand}"
                            CommandParameter="eeprom"
                            ToolTip.Tip="Clear the EEPROM path">
                      <PathIcon Data="{x:Static local:AppIcons.Close}" Width="13" Height="13" />
                    </Button>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Storage" Classes="h3" />
                  <TextBlock Text="Discs and hard-disk images are mounted read-only or through a copy-on-write overlay."
                             Classes="hint" />
                </StackPanel>
                <Border Classes="divider" />

                <StackPanel Spacing="7">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Hard-disk image" Classes="label" />
                    <TextBlock Text="Optional Xbox HDD image (raw or qcow2). Boots the dashboard when no disc is inserted."
                               Classes="hint" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Classes="path"
                             Text="{Binding HddPath, Mode=TwoWay}"
                             PlaceholderText="Optional"
                             ToolTip.Tip="Path to the optional hard-disk image" />
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding BrowseHddCommand}" Content="Browse…"
                            ToolTip.Tip="Choose the hard-disk image file" />
                    <Button Grid.Column="2"
                            Classes="subtle icon"
                            Command="{Binding ClearFieldCommand}"
                            CommandParameter="hdd"
                            ToolTip.Tip="Clear the hard-disk path">
                      <PathIcon Data="{x:Static local:AppIcons.Close}" Width="13" Height="13" />
                    </Button>
                  </Grid>
                </StackPanel>

                <StackPanel Spacing="7">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Default disc image" Classes="label" />
                    <TextBlock Text="Inserted automatically when the console powers on without a selected game (ISO or CHD)."
                               Classes="hint" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Classes="path"
                             Text="{Binding DvdPath, Mode=TwoWay}"
                             PlaceholderText="Optional"
                             ToolTip.Tip="Path to the disc image inserted at power-on" />
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding BrowseDvdCommand}" Content="Browse…"
                            ToolTip.Tip="Choose the default disc image" />
                    <Button Grid.Column="2"
                            Classes="subtle icon"
                            Command="{Binding ClearFieldCommand}"
                            CommandParameter="dvd"
                            ToolTip.Tip="Clear the default disc path">
                      <PathIcon Data="{x:Static local:AppIcons.Close}" Width="13" Height="13" />
                    </Button>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Sega Chihiro" Classes="h3" />
                  <TextBlock Text="A Chihiro is an Xbox with a media board and a DIMM. It boots netboot (.bin) images, not Xbox discs. Put chihiro_xbox_bios.bin, fpr21042_m29w160et.bin, ic10_g24lc64.bin, ic11_24lc024.bin and pc20_g24lc64.bin in the folder below; ver1305.bin is optional for network titles."
                             Classes="hint" TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="divider" />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Enable Chihiro" Classes="label" />
                    <TextBlock Text="Uses the Chihiro BIOS and 128 MB RAM. A .bin image also selects it for that launch."
                               Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ChihiroEnabled, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Boot the Sega Chihiro machine" />
                </Grid>
                <StackPanel Spacing="7">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Chihiro firmware folder" Classes="label" />
                    <TextBlock Text="Empty uses the folder beside the Xbox BIOS image." Classes="hint" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Classes="path"
                             Text="{Binding ChihiroFirmwareDirectory, Mode=TwoWay}"
                             PlaceholderText="Folder with the Chihiro BIOS and media-board files"
                             ToolTip.Tip="Folder holding chihiro_xbox_bios.bin and the media-board firmware" />
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding BrowseChihiroFolderCommand}" Content="Browse."
                            ToolTip.Tip="Choose the Chihiro firmware folder" />
                    <Button Grid.Column="2"
                            Classes="subtle icon"
                            Command="{Binding ClearFieldCommand}"
                            CommandParameter="chihiro-firmware"
                            ToolTip.Tip="Clear the Chihiro firmware folder">
                      <PathIcon Data="{x:Static local:AppIcons.Close}" Width="13" Height="13" />
                    </Button>
                  </Grid>
                  <TextBlock Text="{Binding ChihiroStatusText}" Classes="hint" TextWrapping="Wrap" />
                </StackPanel>

                <Border Classes="divider" />

                <StackPanel Spacing="10">
                  <TextBlock Text="Cabinet" Classes="label" />
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Free play" Classes="label" />
                      <TextBlock Text="Start begins a game without inserting a coin." Classes="hint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ChihiroFreePlay, Mode=TwoWay}"
                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                  ToolTip.Tip="Run the cabinet on free play" />
                  </Grid>
                  <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                    <TextBlock Text="Region" Classes="label" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ChihiroRegionOptions}"
                              SelectedItem="{Binding SelectedChihiroRegion, Mode=TwoWay}"
                              ToolTip.Tip="A game that stops with Error 05 may need another region">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:KeyedOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                  <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                    <TextBlock Text="DIMM size" Classes="label" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ChihiroDimmOptions}"
                              SelectedItem="{Binding SelectedChihiroDimm, Mode=TwoWay}"
                              ToolTip.Tip="Auto follows the cabinet; Gundam needs 1024 MB">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:KeyedOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                  <Grid ColumnDefinitions="170,*" ColumnSpacing="10">
                    <TextBlock Text="Media board" Classes="label" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ChihiroBoardTypeOptions}"
                              SelectedItem="{Binding SelectedChihiroBoardType, Mode=TwoWay}"
                              ToolTip.Tip="Auto follows the cabinet table; early titles may prefer Type 1">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:KeyedOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Force feedback" Classes="label" />
                      <TextBlock Text="Send the drive board's forces to a wheel, or the first gamepad when no wheel is found." Classes="hint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ChihiroForceFeedback, Mode=TwoWay}"
                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                  ToolTip.Tip="Send the drive board's effects to the wheel or gamepad" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"
                        IsEnabled="{Binding ChihiroForceFeedback}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Feedback strength" Classes="label" />
                      <TextBlock Text="0 to 200%; 100 follows the game's request." Classes="hint" />
                    </StackPanel>
                    <Slider Grid.Column="1" Width="220" Minimum="0" Maximum="200"
                            TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding ChihiroFfbStrength, Mode=TwoWay}"
                            ToolTip.Tip="Scale the drive board's force feedback" />
                    <TextBlock Grid.Column="2" Width="44" Classes="mono" FontSize="11"
                               VerticalAlignment="Center" TextAlignment="Right"
                               Text="{Binding ChihiroFfbStrength, StringFormat={}{0}%}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"
                        IsEnabled="{Binding ChihiroForceFeedback}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Wheel weight" Classes="label" />
                      <TextBlock Text="0 to 100%; how much of the drive board's damper the wheel applies." Classes="hint" />
                    </StackPanel>
                    <Slider Grid.Column="1" Width="220" Minimum="0" Maximum="100"
                            TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding ChihiroWheelWeight, Mode=TwoWay}"
                            ToolTip.Tip="Scale the wheel's damping" />
                    <TextBlock Grid.Column="2" Width="44" Classes="mono" FontSize="11"
                               VerticalAlignment="Center" TextAlignment="Right"
                               Text="{Binding ChihiroWheelWeight, StringFormat={}{0}%}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ChihiroForceFeedback}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Autocenter" Classes="label" />
                      <TextBlock Text="Spring the wheel back to centre when the game is not driving it." Classes="hint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ChihiroWheelAutocenter, Mode=TwoWay}"
                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                  ToolTip.Tip="Center the wheel when the game's spring is off" />
                  </Grid>
                  <StackPanel IsEnabled="{Binding ChihiroForceFeedback}">
                    <StackPanel IsEnabled="{Binding ChihiroWheelAutocenter}">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                          <TextBlock Text="Autocenter strength" Classes="label" />
                          <TextBlock Text="0 to 100%." Classes="hint" />
                        </StackPanel>
                        <Slider Grid.Column="1" Width="220" Minimum="0" Maximum="100"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding ChihiroWheelAutocenterStrength, Mode=TwoWay}"
                                ToolTip.Tip="Scale the wheel's self-centering" />
                        <TextBlock Grid.Column="2" Width="44" Classes="mono" FontSize="11"
                                   VerticalAlignment="Center" TextAlignment="Right"
                                   Text="{Binding ChihiroWheelAutocenterStrength, StringFormat={}{0}%}" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding ChihiroForceFeedback}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Invert direction" Classes="label" />
                      <TextBlock Text="Enable if the wheel pulls away from centre instead of toward it." Classes="hint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ChihiroFfbInvert, Mode=TwoWay}"
                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                  ToolTip.Tip="Flip the drive board's force direction" />
                  </Grid>
                </StackPanel>

                <Border Classes="divider" />

                <StackPanel Spacing="7">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Card files" Classes="label" />
                    <TextBlock Text="Names the card image each reader uses. Empty creates a blank card on first insert; choose a .bin to keep a specific card. The readers answer Ghost Squad, Gundam B.O.S. and Maximum Tune."
                               Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Card readers" Classes="label" />
                      <TextBlock Text="Answer the cabinet's HW210 and CRP-1231 readers." Classes="hint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ChihiroCardsEnabled, Mode=TwoWay}"
                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                  ToolTip.Tip="Answer the cabinet's card readers" />
                  </Grid>
                  <StackPanel Spacing="6" IsEnabled="{Binding ChihiroCardsEnabled}">
                    <Grid ColumnDefinitions="170,*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Text="Ghost Squad player 1" Classes="caption" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Classes="path"
                               Text="{Binding ChihiroCardSlot1, Mode=TwoWay}"
                               PlaceholderText="(create a blank card)"
                               ToolTip.Tip="HW210 card for Ghost Squad's player 1" />
                      <Button Grid.Column="2" Classes="ghost"
                              Command="{Binding BrowseChihiroCardCommand}" CommandParameter="hw210-slot1"
                              Content="Browse." ToolTip.Tip="Choose the player-1 card image" />
                      <Button Grid.Column="3" Classes="subtle icon"
                              Command="{Binding ClearFieldCommand}" CommandParameter="chihiro-card-hw210-slot1"
                              ToolTip.Tip="Clear the player-1 card">
                        <PathIcon Data="{x:Static local:AppIcons.Close}" Width="13" Height="13" />
                      </Button>
                    </Grid>
                    <Grid ColumnDefinitions="170,*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Text="Ghost Squad player 2" Classes="caption" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Classes="path"
                               Text="{Binding ChihiroCardSlot2, Mode=TwoWay}"
                               PlaceholderText="(create a blank card)"
                               ToolTip.Tip="HW210 card for Ghost Squad's player 2" />
                      <Button Grid.Column="2" Classes="ghost"
                              Command="{Binding BrowseChihiroCardCommand}" CommandParameter="hw210-slot2"
                              Content="Browse." ToolTip.Tip="Choose the player-2 card image" />
                      <Button Grid.Column="3" Classes="subtle icon"
                              Command="{Binding ClearFieldCommand}" CommandParameter="chihiro-card-hw210-slot2"
                              ToolTip.Tip="Clear the player-2 card">
                        <PathIcon Data="{x:Static local:AppIcons.Close}" Width="13" Height="13" />
                      </Button>
                    </Grid>
                    <Grid ColumnDefinitions="170,*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Text="Gundam B.O.S." Classes="caption" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Classes="path"
                               Text="{Binding ChihiroCardGundam, Mode=TwoWay}"
                               PlaceholderText="(create a blank card)"
                               ToolTip.Tip="HW210 card for Gundam B.O.S." />
                      <Button Grid.Column="2" Classes="ghost"
                              Command="{Binding BrowseChihiroCardCommand}" CommandParameter="hw210-gundam"
                              Content="Browse." ToolTip.Tip="Choose the Gundam card image" />
                      <Button Grid.Column="3" Classes="subtle icon"
                              Command="{Binding ClearFieldCommand}" CommandParameter="chihiro-card-hw210-gundam"
                              ToolTip.Tip="Clear the Gundam card">
                        <PathIcon Data="{x:Static local:AppIcons.Close}" Width="13" Height="13" />
                      </Button>
                    </Grid>
                    <Grid ColumnDefinitions="170,*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Text="Maximum Tune 1" Classes="caption" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Classes="path"
                               Text="{Binding ChihiroCardMt1, Mode=TwoWay}"
                               PlaceholderText="(create a blank card)"
                               ToolTip.Tip="CRP-1231 card for Maximum Tune 1" />
                      <Button Grid.Column="2" Classes="ghost"
                              Command="{Binding BrowseChihiroCardCommand}" CommandParameter="crp1231-mt1"
                              Content="Browse." ToolTip.Tip="Choose the Maximum Tune 1 card image" />
                      <Button Grid.Column="3" Classes="subtle icon"
                              Command="{Binding ClearFieldCommand}" CommandParameter="chihiro-card-crp1231-mt1"
                              ToolTip.Tip="Clear the Maximum Tune 1 card">
                        <PathIcon Data="{x:Static local:AppIcons.Close}" Width="13" Height="13" />
                      </Button>
                    </Grid>
                    <Grid ColumnDefinitions="170,*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Text="Maximum Tune 2" Classes="caption" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Classes="path"
                               Text="{Binding ChihiroCardMt2, Mode=TwoWay}"
                               PlaceholderText="(create a blank card)"
                               ToolTip.Tip="CRP-1231 card for Maximum Tune 2" />
                      <Button Grid.Column="2" Classes="ghost"
                              Command="{Binding BrowseChihiroCardCommand}" CommandParameter="crp1231-mt2"
                              Content="Browse." ToolTip.Tip="Choose the Maximum Tune 2 card image" />
                      <Button Grid.Column="3" Classes="subtle icon"
                              Command="{Binding ClearFieldCommand}" CommandParameter="chihiro-card-crp1231-mt2"
                              ToolTip.Tip="Clear the Maximum Tune 2 card">
                        <PathIcon Data="{x:Static local:AppIcons.Close}" Width="13" Height="13" />
                      </Button>
                    </Grid>
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="7">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Netboot image from a Chihiro game" Classes="label" />
                    <TextBlock Text="An Xbox-format Chihiro ISO has its files already decrypted. A Redump cue/bin set or a MAME .chd converts with the game's small MAME key ZIP; XGrid bundles no keys or game data."
                               Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost"
                            Command="{Binding ConvertChihiroIsoCommand}"
                            Content="Convert ISO..."
                            IsEnabled="{Binding !ChihiroConverting}"
                            ToolTip.Tip="Build a FATX netboot .bin from an Xbox-format Chihiro ISO" />
                    <Button Classes="ghost"
                            Command="{Binding ConvertChihiroGdRomCommand}"
                            Content="Convert GD-ROM..."
                            IsEnabled="{Binding !ChihiroConverting}"
                            ToolTip.Tip="Build a FATX netboot .bin from a Redump cue/bin set and its MAME key ZIP" />
                    <TextBlock Text="{Binding ChihiroConvertStatus}" Classes="hint"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>

                <Border Classes="divider" />

                <StackPanel Spacing="7">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Linked cabinets" Classes="label" />
                    <TextBlock Text="Relays the Chihiro network board between XGrid instances running the same game. Cabinet 1 hosts; the others connect to its address. Each instance needs its own data folder. Ollie King, OutRun 2, OutRun 2 SP and Maximum Tune support linked play."
                               Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Link cabinets" Classes="label" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ChihiroLinkEnabled, Mode=TwoWay}"
                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                  ToolTip.Tip="Relay the network board to other XGrid instances" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"
                        IsEnabled="{Binding ChihiroLinkEnabled}">
                    <TextBlock Text="Cabinets" Classes="label" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Width="180" Minimum="2" Maximum="4"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding ChihiroLinkCabinets, Mode=TwoWay}"
                            ToolTip.Tip="Number of linked cabinets (2 to 4)" />
                    <TextBlock Grid.Column="2" Width="32" Classes="mono" FontSize="11"
                               VerticalAlignment="Center" TextAlignment="Right"
                               Text="{Binding ChihiroLinkCabinets}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"
                        IsEnabled="{Binding ChihiroLinkEnabled}">
                    <TextBlock Text="This cabinet" Classes="label" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Width="180" Minimum="1" Maximum="4"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding ChihiroLinkCabinet, Mode=TwoWay}"
                            ToolTip.Tip="This cabinet's number (1 hosts)" />
                    <TextBlock Grid.Column="2" Width="32" Classes="mono" FontSize="11"
                               VerticalAlignment="Center" TextAlignment="Right"
                               Text="{Binding ChihiroLinkCabinet}" />
                  </Grid>
                  <StackPanel Spacing="2" IsEnabled="{Binding ChihiroLinkEnabled}">
                    <TextBlock Text="Host address" Classes="label" />
                    <TextBox Classes="path"
                             Text="{Binding ChihiroLinkHost, Mode=TwoWay}"
                             PlaceholderText="Empty on cabinet 1; the host's LAN address on the others"
                             ToolTip.Tip="Host cabinet address for cabinets 2 to 4" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Session" Classes="h3" />
                  <TextBlock Text="Choose how XGrid starts, stops and saves the console."
                             Classes="hint" />
                </StackPanel>
                <Border Classes="divider" />

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Power on when XGrid starts" Classes="label" />
                    <TextBlock Text="Boots the configured disc or the dashboard as soon as the window opens. A first run still asks for firmware first."
                               Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding PowerOnAtStartup, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Power on the console when XGrid opens" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Keep XGrid open after power off" Classes="label" />
                    <TextBlock Text="Leave the shell on the powered-off screen. Turn off to close XGrid after a normal console shutdown."
                               Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding StayOpenAfterPowerOff, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Keep the shell open when the console powers off" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Show the powered-off screen" Classes="label" />
                    <TextBlock Text="Show the XGrid logo and a power hint while the console is off. Turn off for a plain black picture area."
                               Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowPoweredOffScreen, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Show a powered-off panel on the console page" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Save state before power off" Classes="label" />
                    <TextBlock Text="Write the automatic session snapshot when you power off or close XGrid. Needs in-process core hosting."
                               Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding SaveStateOnExit, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Save the machine to the automatic session snapshot before stopping" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Resume the saved session" Classes="label" />
                    <TextBlock Text="Load the automatic session snapshot when the Power button starts the dashboard. Launching a game from the library starts it fresh."
                               Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ResumeStateOnStart, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Restore the automatic session snapshot on power-on" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Emulator" Classes="h3" />
                  <TextBlock Text="XGrid runs the console, its renderer and its devices. The emulator is part of this build, not a separate download."
                             Classes="hint" TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="divider" />

                <StackPanel Spacing="7">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Emulator binary" Classes="label" />
                    <TextBlock Text="Optional. Empty uses the emulator shipped with the app, then the build in this repository."
                               Classes="hint" />
                  </StackPanel>
                  <TextBox Classes="path"
                           Text="{Binding XemuCorePath, Mode=TwoWay}"
                           PlaceholderText="Auto-detect"
                           ToolTip.Tip="Path to an emulator binary; empty uses the bundled core" />
                </StackPanel>

                <Border Classes="divider" />

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Guest memory" Classes="label" />
                    <TextBlock Text="64 MB is the retail configuration; 128 MB matches debug-kit hardware." Classes="hint" />
                  </StackPanel>
                  <ComboBox Grid.Column="1"
                            Width="180"
                            ItemsSource="{Binding RamOptions}"
                            SelectedItem="{Binding RamMb, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Guest memory size for the console" />
                </Grid>

                <Border Classes="divider" />

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Core hosting" Classes="label" />
                    <TextBlock Text="In-process loads the core library into the shell and enables save states, pause, frame step and disc swap. It hosts one machine per shell; later launches fall back to a separate process. Separate process can start a new machine every time and isolates a crashing core."
                               Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1"
                            Width="220"
                            ItemsSource="{Binding CoreHostingOptions}"
                            SelectedItem="{Binding SelectedCoreHosting, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Choose whether the core runs in-process or separately">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:KeyedOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===================== Graphics ===================== -->
      <TabItem Header="Graphics" ToolTip.Tip="Renderer, filtering and display options">
        <ScrollViewer>
          <StackPanel Spacing="16" MaxWidth="1040" HorizontalAlignment="Stretch">
            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Graphics" Classes="h3" />
                  <TextBlock Text="The emulator renders on the host GPU. It has no DirectX or software backend, so those are not offered."
                             Classes="hint" TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="divider" />

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Renderer" Classes="label" />
                    <TextBlock Text="{Binding RendererHint}" Classes="hint" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="220"
                            ItemsSource="{Binding RendererOptions}"
                            SelectedItem="{Binding SelectedRenderer, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Choose the graphics renderer">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:KeyedOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Internal resolution scale" Classes="label" />
                    <TextBlock Text="Renders the guest at a multiple of its native resolution." Classes="hint" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="180"
                            ItemsSource="{Binding SurfaceScaleOptions}"
                            SelectedItem="{Binding SurfaceScale, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Choose the internal resolution multiplier" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Texture filtering" Classes="label" />
                    <TextBlock Text="Applied by the core to guest textures." Classes="hint" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="220"
                            ItemsSource="{Binding FilteringOptions}"
                            SelectedItem="{Binding SelectedFiltering, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Choose the core texture filter">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:KeyedOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Window startup size" Classes="label" />
                    <TextBlock Text="Used when the core starts in a window; the shell still embeds it." Classes="hint" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="220"
                            ItemsSource="{Binding StartupSizeOptions}"
                            SelectedItem="{Binding SelectedStartupSize, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Choose the window size used when the core starts">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:KeyedOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Vertical sync" Classes="label" />
                    <TextBlock Text="Waits for the display refresh. Leave off for lowest input latency." Classes="hint" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding GraphicsVSync, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Wait for the display refresh to avoid tearing" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Start fullscreen" Classes="label" />
                    <TextBlock Text="The embedded window follows the core's own mode." Classes="hint" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding FullscreenOnStartup, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Start the console in fullscreen" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Exclusive fullscreen" Classes="label" />
                    <TextBlock Text="Only used when fullscreen starts." Classes="hint" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding FullscreenExclusive, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Use exclusive fullscreen when starting" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Aspect ratio" Classes="label" />
                    <TextBlock Text="The core's picture fit inside its window." Classes="hint" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="220"
                            ItemsSource="{Binding AspectRatioOptions}"
                            SelectedItem="{Binding SelectedAspectRatio, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Choose the picture aspect ratio">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:KeyedOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Fit mode" Classes="label" />
                    <TextBlock Text="Scale preserves the aspect ratio; stretch fills the window." Classes="hint" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="220"
                            ItemsSource="{Binding FitOptions}"
                            SelectedItem="{Binding SelectedFit, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Choose how the picture fills its window">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:KeyedOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="AV pack" Classes="label" />
                    <TextBlock Text="The video output the console reports to the guest." Classes="hint" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="220"
                            ItemsSource="{Binding AvPackOptions}"
                            SelectedItem="{Binding SelectedAvPack, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Choose the reported video output standard">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:KeyedOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <Border Classes="divider" />

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Presentation filter" Classes="label" />
                    <TextBlock Text="Applied by the core to the final picture: nearest or bilinear sampling, or a scanline/CRT phosphor mask."
                               Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1"
                            Width="220"
                            ItemsSource="{Binding FilterOptions}"
                            SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Choose the core presentation filter">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:KeyedOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===================== Audio ===================== -->
      <TabItem Header="Audio" ToolTip.Tip="Audio backend and mixer options">
        <ScrollViewer>
          <StackPanel Spacing="16" MaxWidth="1040" HorizontalAlignment="Stretch">
            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Audio" Classes="h3" />
                  <TextBlock Text="The core runs the guest DSP and mixes the APU voices; these options select the host sink and mixer behavior."
                             Classes="hint" TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="divider" />

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Host audio backend" Classes="label" />
                    <TextBlock Text="Auto lets the core choose; WAV capture writes audio.wav in the core working directory." Classes="hint" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="220"
                            ItemsSource="{Binding AudioBackendOptions}"
                            SelectedItem="{Binding SelectedAudioBackend, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Choose the host audio output backend">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:KeyedOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <TextBlock Text="{Binding AudioBackendHint}" Classes="hint" TextWrapping="Wrap" />

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"
                      IsVisible="{Binding ShowAudioDeviceList}">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Output device" Classes="label" />
                    <TextBlock Text="DirectSound playback device. System default follows Windows."
                               Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="250"
                            ItemsSource="{Binding AudioDeviceOptions}"
                            SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Choose the DirectSound output device">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:KeyedOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="2" Classes="ghost" Content="Refresh"
                          Command="{Binding RefreshAudioDevicesCommand}"
                          ToolTip.Tip="Re-read the host output devices" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowAudioDeviceText}">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Device" Classes="label" />
                    <TextBlock Text="Optional backend-specific device or server name. Empty follows the system default."
                               Classes="hint" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Width="250"
                           Text="{Binding AudioDevice, Mode=TwoWay}"
                           PlaceholderText="System default"
                           ToolTip.Tip="Backend-specific output device name" />
                </Grid>

                <TextBlock Text="{Binding AudioDeviceHint}" Classes="hint" TextWrapping="Wrap" />

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Guest DSP" Classes="label" />
                    <TextBlock Text="Runs the APU's GP/EP microcode. Required for game audio." Classes="hint" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseDsp, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Enable the guest DSP for game audio" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding UseDsp}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="DSP JIT" Classes="label" />
                    <TextBlock Text="Native code generation for the DSP. Off keeps the interpreter." Classes="hint" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseDspJit, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Compile DSP microcode to native code" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="HRTF" Classes="label" />
                    <TextBlock Text="Head-related filtering for 3D voices." Classes="hint" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Hrtf, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Enable head-related filtering for 3D voices" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Volume limit" Classes="label" />
                    <TextBlock Text="Caps the mixed output; 100% is the core default." Classes="hint" />
                  </StackPanel>
                  <Slider Grid.Column="1" Width="220" Minimum="0" Maximum="1" TickFrequency="0.05"
                          Value="{Binding VolumeLimit, Mode=TwoWay}"
                          ToolTip.Tip="Set the maximum mixed output volume" />
                  <TextBlock Grid.Column="2" Width="48" Classes="mono" FontSize="11"
                             VerticalAlignment="Center" TextAlignment="Right"
                             Text="{Binding VolumeLimit, StringFormat={}{0:P0}}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Voice workers" Classes="label" />
                    <TextBlock Text="0 lets the core choose; higher values parallelize the voice processor." Classes="hint" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="180"
                            ItemsSource="{Binding VoiceWorkerOptions}"
                            SelectedItem="{Binding VoiceWorkers, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Choose how many threads mix APU voices" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===================== Input ===================== -->
      <TabItem Header="Input" ToolTip.Tip="Keyboard, gamepad and player bindings">
        <ScrollViewer>
          <StackPanel Spacing="16" MaxWidth="1040" HorizontalAlignment="Stretch">
            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Input" Classes="h3" />
                  <TextBlock Text="Keyboard and gamepad bindings for players 1 to 4. Click a key button, then press the new key; Esc cancels."
                             Classes="hint" TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="divider" />

                <TextBlock Text="Keyboard" Classes="label" />
                <ItemsControl ItemsSource="{Binding KeyboardBindings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:KeyboardBindingItem">
                      <Grid ColumnDefinitions="170,*,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ActionName}" Classes="caption" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="ghost"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding CaptureCommand}"
                                Content="{Binding KeysDisplay}"
                                ToolTip.Tip="Click, then press the new key; Esc cancels" />
                        <Button Grid.Column="2"
                                Classes="subtle icon"
                                Width="32"
                                Height="32"
                                Command="{Binding ClearCommand}"
                                ToolTip.Tip="Clear binding">
                          <PathIcon Data="{x:Static local:AppIcons.Close}" Width="12" Height="12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="divider" />

                <TextBlock Text="Gamepad" Classes="label" />
                <ItemsControl ItemsSource="{Binding GamepadBindings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:GamepadBindingItem">
                      <Grid ColumnDefinitions="170,*" ColumnSpacing="10" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ActionName}" Classes="caption" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Sources}"
                                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  ToolTip.Tip="Choose the gamepad input for this action">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:KeyedOption">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="divider" />

                <StackPanel Spacing="6">
                  <TextBlock Text="Players" Classes="label" />
                  <TextBlock Text="Assign one XInput slot to each Xbox port. All four ports are published to the core, so four controllers can play together. The keyboard always drives player 1; the gamepad map and stick options above apply to every player."
                             Classes="hint" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding PlayerPads}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:PlayerPadItem">
                        <Grid ColumnDefinitions="170,*" ColumnSpacing="10" Margin="0,0,0,6">
                          <TextBlock Text="{Binding Label}" Classes="caption" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="1"
                                    Width="200"
                                    HorizontalAlignment="Left"
                                    ItemsSource="{Binding Options}"
                                    SelectedItem="{Binding Selected, Mode=TwoWay}"
                                    ToolTip.Tip="Choose the XInput slot for this player">
                            <ComboBox.ItemTemplate>
                              <DataTemplate DataType="vm:KeyedOption">
                                <TextBlock Text="{Binding Label}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Left stick dead zone" Classes="label" />
                    <TextBlock Text="Radial dead zone applied before the report is published." Classes="hint" />
                  </StackPanel>
                  <Slider Grid.Column="1" Width="220" Minimum="0" Maximum="50" TickFrequency="1"
                          IsSnapToTickEnabled="True" Value="{Binding LeftDeadZone, Mode=TwoWay}"
                          ToolTip.Tip="Set the left stick dead zone" />
                  <TextBlock Grid.Column="2" Width="44" Classes="mono" FontSize="11"
                             VerticalAlignment="Center" TextAlignment="Right"
                             Text="{Binding LeftDeadZone, StringFormat={}{0:0}%}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Right stick dead zone" Classes="label" />
                    <TextBlock Text="Radial dead zone applied before the report is published." Classes="hint" />
                  </StackPanel>
                  <Slider Grid.Column="1" Width="220" Minimum="0" Maximum="50" TickFrequency="1"
                          IsSnapToTickEnabled="True" Value="{Binding RightDeadZone, Mode=TwoWay}"
                          ToolTip.Tip="Set the right stick dead zone" />
                  <TextBlock Grid.Column="2" Width="44" Classes="mono" FontSize="11"
                             VerticalAlignment="Center" TextAlignment="Right"
                             Text="{Binding RightDeadZone, StringFormat={}{0:0}%}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Trigger threshold" Classes="label" />
                    <TextBlock Text="Values below this are reported as released." Classes="hint" />
                  </StackPanel>
                  <Slider Grid.Column="1" Width="220" Minimum="0" Maximum="100" TickFrequency="1"
                          IsSnapToTickEnabled="True" Value="{Binding TriggerThreshold, Mode=TwoWay}"
                          ToolTip.Tip="Set the trigger press threshold" />
                  <TextBlock Grid.Column="2" Width="44" Classes="mono" FontSize="11"
                             VerticalAlignment="Center" TextAlignment="Right"
                             Text="{Binding TriggerThreshold, StringFormat={}{0:0}%}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Invert left stick Y" Classes="label" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding InvertLeftY, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Invert the left stick vertical axis" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Invert right stick Y" Classes="label" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding InvertRightY, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Invert the right stick vertical axis" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Swap left and right sticks" Classes="label" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding SwapSticks, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center"
                                ToolTip.Tip="Swap the left and right stick axes" />
                </Grid>

                <Button Classes="ghost" Command="{Binding ResetInputDefaultsCommand}"
                        HorizontalAlignment="Left" Content="Reset input defaults"
                        ToolTip.Tip="Restore the default keyboard and gamepad bindings" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Sega Chihiro cabinet keys" Classes="h3" />
                  <TextBlock Text="Keyboard and mouse bindings for the cabinet. Click a key button, then press the new key; Esc cancels. The gun actions show their mouse defaults until changed."
                             Classes="hint" TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="divider" />

                <TextBlock Text="System" Classes="label" />
                <ItemsControl ItemsSource="{Binding ChihiroSystemBindings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ChihiroBindingItem">
                      <Grid ColumnDefinitions="170,*,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ActionName}" Classes="caption" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding CaptureCommand}" Content="{Binding KeysDisplay}"
                                ToolTip.Tip="Click, then press the new key; Esc cancels" />
                        <Button Grid.Column="2" Classes="subtle icon" Width="32" Height="32"
                                Command="{Binding ClearCommand}" ToolTip.Tip="Clear binding">
                          <PathIcon Data="{x:Static local:AppIcons.Close}" Width="12" Height="12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="divider" />

                <TextBlock Text="Driving" Classes="label" />
                <ItemsControl ItemsSource="{Binding ChihiroDrivingBindings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ChihiroBindingItem">
                      <Grid ColumnDefinitions="170,*,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ActionName}" Classes="caption" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding CaptureCommand}" Content="{Binding KeysDisplay}"
                                ToolTip.Tip="Click, then press the new key; Esc cancels" />
                        <Button Grid.Column="2" Classes="subtle icon" Width="32" Height="32"
                                Command="{Binding ClearCommand}" ToolTip.Tip="Clear binding">
                          <PathIcon Data="{x:Static local:AppIcons.Close}" Width="12" Height="12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="divider" />

                <TextBlock Text="Gun games" Classes="label" />
                <ItemsControl ItemsSource="{Binding ChihiroGunBindings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ChihiroBindingItem">
                      <Grid ColumnDefinitions="170,*,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ActionName}" Classes="caption" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding CaptureCommand}" Content="{Binding KeysDisplay}"
                                ToolTip.Tip="Click, then press the new key; Esc cancels" />
                        <Button Grid.Column="2" Classes="subtle icon" Width="32" Height="32"
                                Command="{Binding ClearCommand}" ToolTip.Tip="Clear binding">
                          <PathIcon Data="{x:Static local:AppIcons.Close}" Width="12" Height="12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="divider" />

                <TextBlock Text="Player 2 (gun cabinets)" Classes="label" />
                <TextBlock Text="A second gamepad aims with its right stick; the arrow keys also move the crosshair. RT fires, A is body, B is change or pedal, LT reloads and X inserts a card. These rows name the keyboard and mouse alternatives."
                           Classes="hint" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding ChihiroPlayer2Bindings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ChihiroBindingItem">
                      <Grid ColumnDefinitions="170,*,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ActionName}" Classes="caption" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding CaptureCommand}" Content="{Binding KeysDisplay}"
                                ToolTip.Tip="Click, then press the new key; Esc cancels" />
                        <Button Grid.Column="2" Classes="subtle icon" Width="32" Height="32"
                                Command="{Binding ClearCommand}" ToolTip.Tip="Clear binding">
                          <PathIcon Data="{x:Static local:AppIcons.Close}" Width="12" Height="12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Player 2 aim speed" Classes="label" />
                    <TextBlock Text="0 to 400%; 100 crosses the picture in about 0.75 seconds." Classes="hint" />
                  </StackPanel>
                  <Slider Grid.Column="1" Width="220" Minimum="0" Maximum="400"
                          TickFrequency="5" IsSnapToTickEnabled="True"
                          Value="{Binding ChihiroP2AimSpeed, Mode=TwoWay}"
                          ToolTip.Tip="Scale how fast player 2's crosshair moves" />
                  <TextBlock Grid.Column="2" Width="44" Classes="mono" FontSize="11"
                             VerticalAlignment="Center" TextAlignment="Right"
                             Text="{Binding ChihiroP2AimSpeed, StringFormat={}{0}%}" />
                </Grid>

                <Border Classes="divider" />

                <TextBlock Text="Gundam cockpit" Classes="label" />
                <TextBlock Text="Gundam Battle Operating Simulator's twin-stick cockpit. Defaults are WASD + Q/E on the left, the arrow keys + Right Shift/Ctrl on the right, and Space for the pedal."
                           Classes="hint" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding ChihiroGundamBindings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ChihiroBindingItem">
                      <Grid ColumnDefinitions="170,*,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ActionName}" Classes="caption" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding CaptureCommand}" Content="{Binding KeysDisplay}"
                                ToolTip.Tip="Click, then press the new key; Esc cancels" />
                        <Button Grid.Column="2" Classes="subtle icon" Width="32" Height="32"
                                Command="{Binding ClearCommand}" ToolTip.Tip="Clear binding">
                          <PathIcon Data="{x:Static local:AppIcons.Close}" Width="12" Height="12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Classes="ghost" Command="{Binding ResetChihiroKeysCommand}"
                        HorizontalAlignment="Left" Content="Reset cabinet keys"
                        ToolTip.Tip="Restore the default Chihiro cabinet bindings" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===================== Per-title overrides ===================== -->
      <TabItem Header="Titles" ToolTip.Tip="Per-title memory and graphics overrides">
        <ScrollViewer>
          <StackPanel Spacing="16" MaxWidth="1040" HorizontalAlignment="Stretch">
            <Border Classes="card">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Per-title overrides" Classes="h3" />
                    <TextBlock Text="Guest memory and graphics applied when a specific disc or XBE is launched. Unset values inherit the global configuration."
                               Classes="hint" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost" Command="{Binding AddTitleOverrideCommand}"
                          ToolTip.Tip="Add a per-title settings override">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <PathIcon Data="{x:Static local:AppIcons.Folder}" Width="13" Height="13" />
                      <TextBlock Text="Add override" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Border Classes="divider" />

                <ItemsControl ItemsSource="{Binding TitleOverrides}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:TitleOverrideItem">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayName}" Classes="label" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding PathText}" Classes="mono" FontSize="10.5"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource XgTextMutedBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Width="105"
                                  ItemsSource="{Binding RamOptions}"
                                  SelectedItem="{Binding SelectedRam, Mode=TwoWay}"
                                  ToolTip.Tip="Guest memory for this title"
                                  VerticalAlignment="Center">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:KeyedOption">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="2"
                                  Width="115"
                                  ItemsSource="{Binding RendererOptions}"
                                  SelectedItem="{Binding SelectedRenderer, Mode=TwoWay}"
                                  ToolTip.Tip="Renderer for this title"
                                  VerticalAlignment="Center">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:KeyedOption">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="3"
                                  Width="105"
                                  ItemsSource="{Binding FilteringOptions}"
                                  SelectedItem="{Binding SelectedFiltering, Mode=TwoWay}"
                                  ToolTip.Tip="Core texture filtering for this title"
                                  VerticalAlignment="Center">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:KeyedOption">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="4"
                                  Width="135"
                                  ItemsSource="{Binding FilterOptions}"
                                  SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                                  ToolTip.Tip="Presentation filter for this title"
                                  VerticalAlignment="Center">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:KeyedOption">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="5"
                                Classes="subtle icon"
                                Width="32"
                                Height="32"
                                Command="{Binding RemoveCommand}"
                                ToolTip.Tip="Remove override">
                          <PathIcon Data="{x:Static local:AppIcons.Close}" Width="12" Height="12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock IsVisible="{Binding !HasTitleOverrides}"
                           Text="No overrides yet. Add one for a title that needs different guest memory or graphics."
                           Classes="hint" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===================== Library ===================== -->
      <TabItem Header="Library" ToolTip.Tip="Library folders and cover art">
        <ScrollViewer>
          <StackPanel Spacing="16" MaxWidth="1040" HorizontalAlignment="Stretch">
            <Border Classes="card">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Game library" Classes="h3" />
                    <TextBlock Text="Folders scanned recursively for ISO, CHD, and XBE files." Classes="hint" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost" Command="{Binding AddLibraryFolderCommand}"
                          ToolTip.Tip="Add a folder to scan for games">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <PathIcon Data="{x:Static local:AppIcons.Folder}" Width="13" Height="13" />
                      <TextBlock Text="Add folder" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Border Classes="divider" />

                <ItemsControl ItemsSource="{Binding LibraryFolders}" IsVisible="{Binding HasLibraryFolders}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:LibraryFolderItem">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                        <PathIcon Data="{x:Static local:AppIcons.Folder}"
                                  Width="14"
                                  Height="14"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource XgTextMutedBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Path}"
                                   Classes="mono"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Classes="subtle icon"
                                Width="32"
                                Height="32"
                                Command="{Binding RemoveCommand}"
                                ToolTip.Tip="Remove folder">
                          <PathIcon Data="{x:Static local:AppIcons.Close}" Width="12" Height="12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock IsVisible="{Binding !HasLibraryFolders}"
                           Text="No folders yet. Add one to populate the library page."
                           Classes="hint" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Cover art" Classes="h3" />
                    <TextBlock Text="Local covers are matched by title id, exact name, and fuzzy title matching. The online catalog is the same content-addressed layout as 5DO: a JSON index plus WebP images on Cloudflare R2."
                               Classes="hint"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost" Command="{Binding Shell.OpenCoversFolderCommand}"
                          ToolTip.Tip="Show the folder that holds cover images">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <PathIcon Data="{x:Static local:AppIcons.Folder}" Width="13" Height="13" />
                      <TextBlock Text="Open folder" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Border Classes="divider" />

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Text="Local covers folder" Classes="label" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding CoverDirectory, Mode=TwoWay}"
                           PlaceholderText="Empty uses the default covers folder"
                           Classes="mono"
                           ToolTip.Tip="Folder containing PNG, JPEG, WebP or BMP cover images." />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Classes="ghost" Command="{Binding BrowseCoverDirectoryCommand}" Content="Browse"
                            ToolTip.Tip="Choose a folder containing cover images" />
                    <Button Classes="ghost" Command="{Binding ResetCoverDirectoryCommand}" Content="Default"
                            ToolTip.Tip="Use the shared covers folder under the XGrid data directory" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Cover files may be named after the game, e.g. Halo - Combat Evolved (USA).png, or after the XBE title id, e.g. 4D530002.png. Annotation groups are ignored while matching."
                           Classes="hint"
                           TextWrapping="Wrap" />

                <CheckBox IsChecked="{Binding UseOnlineCovers, Mode=TwoWay}"
                          Content="Use the online cover catalog"
                          ToolTip.Tip="Resolve missing covers from the R2 catalog. Local covers keep working offline." />
                <CheckBox IsChecked="{Binding AutoDownloadCovers, Mode=TwoWay}"
                          Content="Download missing covers automatically after a scan"
                          ToolTip.Tip="Only covers matched to games in your library are downloaded." />

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Text="Catalog URL" Classes="label" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding CoverCatalogUrl, Mode=TwoWay}"
                           Classes="mono"
                           ToolTip.Tip="Catalog URL or base URL. It is normalized to catalog.json." />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Classes="ghost" Command="{Binding ResetCoverCatalogUrlCommand}" Content="Default"
                            ToolTip.Tip="Restore the XGrid R2 catalog URL" />
                    <Button Classes="ghost" Command="{Binding RefreshCoverCatalogCommand}" Content="Refresh"
                            ToolTip.Tip="Fetch the catalog now and rescan covers" />
                  </StackPanel>
                </Grid>

                <CheckBox IsChecked="{Binding CoverFuzzyMatching, Mode=TwoWay}"
                          Content="Fuzzy title matching"
                          ToolTip.Tip="Use Jaro-Winkler matching after the exact and annotation-stripped passes." />
                <CheckBox IsChecked="{Binding CoverStripAnnotations, Mode=TwoWay}"
                          Content="Ignore region, language and revision annotations"
                          ToolTip.Tip="Strip (USA), (Europe), (En,Fr,De), Rev 1 and similar groups before matching." />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <TextBlock Text="Fuzzy threshold" Classes="label" VerticalAlignment="Center" />
                  <Slider Grid.Column="1"
                          Minimum="0.70"
                          Maximum="0.95"
                          TickFrequency="0.01"
                          Value="{Binding CoverFuzzyThreshold, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Higher values prefer a missing cover over a wrong one." />
                  <TextBlock Grid.Column="2"
                             Text="{Binding CoverFuzzyThreshold, StringFormat={}{0:P0}}"
                             Classes="mono"
                             VerticalAlignment="Center"
                             MinWidth="48" />
                </Grid>

                <Border Classes="divider" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding CoverCacheText}" Classes="hint" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Command="{Binding ClearCoverCacheCommand}" Content="Clear cache"
                          ToolTip.Tip="Delete the cached catalog and downloaded cover images" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===================== Appearance ===================== -->
      <TabItem Header="Appearance" ToolTip.Tip="Accent color and theme options">
        <ScrollViewer>
          <StackPanel Spacing="16" MaxWidth="1040" HorizontalAlignment="Stretch">
            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Appearance" Classes="h3" />
                  <TextBlock Text="XGrid uses a dark theme on every platform. Pick an accent for highlights and controls."
                             Classes="hint" />
                </StackPanel>
                <Border Classes="divider" />

                <ListBox Classes="swatches"
                         ItemsSource="{Binding AccentOptions}"
                         SelectedItem="{Binding SelectedAccent, Mode=TwoWay}"
                         ToolTip.Tip="Choose the accent color for highlights and controls">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:AccentOption">
                      <StackPanel Spacing="6" Width="72">
                        <Border Width="46"
                                Height="46"
                                CornerRadius="13"
                                HorizontalAlignment="Center"
                                Background="{Binding Brush}">
                          <PathIcon Data="{x:Static local:AppIcons.Check}"
                                    Width="18"
                                    Height="18"
                                    Foreground="#06200F"
                                    IsVisible="{Binding IsSelected}" />
                        </Border>
                        <TextBlock Text="{Binding Label}"
                                   Classes="caption"
                                   FontSize="10"
                                   HorizontalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>

            <TextBlock Text="Changes take effect on the next power-on."
                       Classes="hint"
                       Margin="2,4,2,8" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
