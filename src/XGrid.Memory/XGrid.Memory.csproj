<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
      <RootNamespace>XGrid.Memory</RootNamespace>
      <AssemblyName>XGrid.Memory</AssemblyName>
      <!-- Host-backed RAM for the native CPU host is a raw pointer into a
           shared section; every other use stays a managed array. -->
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XGrid.Core\XGrid.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
