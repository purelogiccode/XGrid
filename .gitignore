# Build output
bin/
obj/
publish/
publish-probe/
artifacts/
dist/

# IDE
.vs/
.idea/
*.user
*.suo
*.DotSettings.user

# Test/benchmark output
TestResults/
BenchmarkDotNet.Artifacts/
coverage/

# Development tool scratch output (the dsp oracle builds the reference copy here)
tools/dsp-oracle/build/

# OS
.DS_Store
Thumbs.db

# Reference material (large, licensed third-party sources - never committed)
References/
References2/
*.zip

# Local firmware/user data - never committed
*.bin
*.iso
*.xiso
*.cso
*.img
*.qcow2
*.qcow2c
*.xbe
!src/XGrid.Xbe/
*.exe
*.log
eeprom.bin
bios.bin
mcpx.bin

# Local emulator runtime data (disk images, shader caches, configs) - never committed
data/

# Wave scratch (private media copies, ramdumps, probe logs)
wt-data/
runs/

# Wave tooling
node_modules/

# Native cores (vendored source/build trees; patches, shims and scripts are tracked)
native/**/build/
# Per-RID core staging for scripts/package.ps1 -CoreRoot
cores/


# GPU golden harness artifacts (regenerated by scripts/gpu-slice*-golden.ps1)
golden-sw.bmp
golden-gl.bmp
tri-golden-sw.bmp
tri-golden-gl.bmp

# Python tooling caches
__pycache__/
*.pyc

# Vendored xemu tree: tracked source, build output excluded. The negation must
# follow the media rules above so pc-bios and test data (which the
# repository-wide *.bin/*.iso rules would drop) are committed.
!xemu/**
xemu/build/
xemu/dist/
xemu/obj/
xemu/bin/

# Meson subproject bookkeeping (generated when wrap dependencies are fetched)
.meson-subproject-wrap-hash.txt
